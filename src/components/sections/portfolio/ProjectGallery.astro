---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

type Props = {
  projectId: string
  images: { src: ImageMetadata; alt: string; caption?: string }[]
  layout: 'stack' | 'masonry'
  heading?: string
}

const { projectId, images: galleryImages, layout, heading } = Astro.props
const bayaanLandscapeImages = new Set([
  'Bayaan Academy students standing together onstage during a fundraising event',
  'Bayaan Academy students and adults gathered onstage during a fundraising event',
])
const bayaanGalleryGroups = galleryImages.reduce<
  Array<
    | { type: 'portraits'; images: typeof galleryImages }
    | { type: 'landscape'; image: (typeof galleryImages)[number] }
  >
>((groups, image) => {
  if (bayaanLandscapeImages.has(image.alt)) {
    groups.push({ type: 'landscape', image })
    return groups
  }

  const lastGroup = groups.at(-1)
  if (lastGroup?.type === 'portraits') {
    lastGroup.images.push(image)
  } else {
    groups.push({ type: 'portraits', images: [image] })
  }

  return groups
}, [])
const galleryHeading =
  heading ??
  (projectId === 'bayaan-academy' || projectId === 'arqam-academy'
    ? 'Photography'
    : 'Additional visuals')
---

<section
  class="mx-auto max-w-4xl py-8 sm:py-10"
  aria-labelledby="gallery-title"
  data-reveal="up"
>
  <h2 id="gallery-title" class="font-heading text-2xl font-bold">
    {galleryHeading}
  </h2>
  {layout === 'masonry' ? (
    <div class="mt-6 columns-1 gap-4 sm:columns-2">
      {galleryImages.map((image, index) => (
        <figure
          class="mb-6 break-inside-avoid"
          data-reveal={index < 12 ? 'up' : undefined}
          style={
            index < 12
              ? `--reveal-delay: ${Math.min(index, 8) * 35}ms`
              : undefined
          }
        >
          <Image
            src={image.src}
            alt={image.alt}
            width={Math.min(image.src.width, 1280)}
            layout="full-width"
            widths={[480, 768, 1024, 1280]}
            sizes="(min-width: 640px) 50vw, 100vw"
            quality={75}
            loading={index < 2 ? 'eager' : 'lazy'}
            decoding="async"
            class="block h-auto w-full"
          />
          {image.caption && (
            <figcaption class="text-muted-foreground mt-2 text-sm">
              {image.caption}
            </figcaption>
          )}
        </figure>
      ))}
    </div>
  ) : projectId === 'bayaan-academy' ? (
    <div class="mt-6 space-y-6">
      {bayaanGalleryGroups.map((group, groupIndex) =>
        group.type === 'landscape' ? (
          <figure data-reveal="up">
            <Image
              src={group.image.src}
              alt={group.image.alt}
              width={Math.min(group.image.src.width, 1280)}
              layout="full-width"
              widths={[640, 960, 1280, 1600]}
              sizes="(min-width: 1280px) 896px, 100vw"
              quality={80}
              loading={groupIndex === 0 ? 'eager' : 'lazy'}
              class="block h-auto w-full"
            />
            {group.image.caption && (
              <figcaption class="text-muted-foreground mt-2 text-sm">
                {group.image.caption}
              </figcaption>
            )}
          </figure>
        ) : (
          <div class="columns-1 gap-4 sm:columns-2">
            {group.images.map((image, index) => (
              <figure
                class="mb-6 break-inside-avoid"
                data-reveal={index < 12 ? 'up' : undefined}
                style={
                  index < 12
                    ? `--reveal-delay: ${Math.min(index, 8) * 35}ms`
                    : undefined
                }
              >
                <Image
                  src={image.src}
                  alt={image.alt}
                  width={Math.min(image.src.width, 1024)}
                  layout="full-width"
                  widths={[480, 768, 1024]}
                  sizes="(min-width: 640px) 50vw, 100vw"
                  quality={80}
                  loading={groupIndex < 2 && index < 2 ? 'eager' : 'lazy'}
                  class="block h-auto w-full"
                />
                {image.caption && (
                  <figcaption class="text-muted-foreground mt-2 text-sm">
                    {image.caption}
                  </figcaption>
                )}
              </figure>
            ))}
          </div>
        ),
      )}
    </div>
  ) : projectId === 'arqam-academy' ? (
    <div class="mt-6 grid grid-cols-1 gap-x-4 gap-y-8 sm:grid-cols-2">
      {galleryImages.map((image, index) => (
        <figure
          data-reveal={index < 12 ? 'up' : undefined}
          style={
            index < 12
              ? `--reveal-delay: ${Math.min(index, 8) * 35}ms`
              : undefined
          }
        >
          <Image
            src={image.src}
            alt={image.alt}
            layout="full-width"
            widths={[480, 768, 1024]}
            width={Math.min(image.src.width, 1024)}
            sizes="(min-width: 640px) 50vw, 100vw"
            quality={80}
            loading={index < 2 ? 'eager' : 'lazy'}
            class="block h-auto w-full"
          />
          {image.caption && (
            <figcaption class="text-muted-foreground mt-2 text-sm">
              {image.caption}
            </figcaption>
          )}
        </figure>
      ))}
    </div>
  ) : (
    <div class="mt-6 space-y-8">
      {galleryImages.map((image, index) => (
        <figure
          data-reveal={index < 12 ? 'up' : undefined}
          style={
            index < 12
              ? `--reveal-delay: ${Math.min(index, 8) * 35}ms`
              : undefined
          }
        >
          <Image
            src={image.src}
            alt={image.alt}
            layout="full-width"
            widths={[640, 960, 1280, 1600]}
            width={Math.min(image.src.width, 1280)}
            sizes="(min-width: 1280px) 896px, 100vw"
            quality={80}
            loading={index < 2 ? 'eager' : 'lazy'}
            class="block h-auto w-full"
          />
          {image.caption && (
            <figcaption class="text-muted-foreground mt-2 text-sm">
              {image.caption}
            </figcaption>
          )}
        </figure>
      ))}
    </div>
  )}
</section>
