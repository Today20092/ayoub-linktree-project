---
import { CreditCard } from 'lucide-react'

import { simpleIconBody } from '@/lib/simple-icons'
import type { ActionLink } from '@/lib/site-config'

type Props = {
  supportLinks: ActionLink[]
  currentYear: number
}

const { supportLinks, currentYear } = Astro.props
---

<footer
  class="border-border text-muted-foreground mt-16 flex flex-col gap-8 border-t py-8 text-sm sm:flex-row sm:items-end sm:justify-between lg:mt-24"
  data-reveal="fade"
>
  <div class="min-w-0">
    <p class="mb-3 text-xs font-semibold tracking-wider uppercase">Support</p>
    <nav
      class="flex min-w-0 flex-col items-start gap-x-6 gap-y-3 sm:flex-row sm:flex-wrap"
      aria-label="Support and payment links"
    >
      {supportLinks.map((link) => (
        <a
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
          class="link-quiet text-foreground hover:bg-accent hover:text-accent-foreground inline-flex min-h-12 max-w-full min-w-0 items-center gap-3 px-2 py-2 text-base font-bold transition-[color,background-color,transform] active:scale-[0.98]"
        >
          {link.icon === 'lucide:credit-card' ? (
            <CreditCard className="size-5 shrink-0" aria-hidden="true" />
          ) : (
            link.icon && (
              <svg
                class="size-5 shrink-0"
                viewBox="0 0 24 24"
                aria-hidden="true"
                set:html={simpleIconBody(link.icon)}
              />
            )
          )}
          <span class="min-w-0 wrap-break-word">{link.label}</span>
        </a>
      ))}
    </nav>
  </div>
  <p>{`© ${currentYear} Ayoub Abedrabbo`}</p>
</footer>
