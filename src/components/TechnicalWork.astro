---
import { Image } from 'astro:assets'
import simpleIcons from '@iconify-json/simple-icons/icons.json'
import {
  ArrowUpRight,
  AudioLines,
  Clapperboard,
  GitMerge,
  HardDrive,
  MessageSquareText,
  Timer,
} from 'lucide-react'

import ayoubabedShot from '@/assets/technical-work/ayoubabed-site.png'
import lutBuilderShot from '@/assets/technical-work/lut-builder.png'
import rateControlShot from '@/assets/technical-work/rate-control.png'
import yahalaShot from '@/assets/technical-work/yahala-site.png'

// Projects with a page to look at get a screenshot; the rest get an icon.
const featured = [
  {
    name: 'yahalausa.net',
    kind: 'Client website',
    line: 'Media hub for Ya Hala. Views and episodes update on their own.',
    url: 'https://www.yahalausa.net',
    image: yahalaShot,
    alt: 'Ya Hala USA homepage with the show banner and a total views counter',
  },
  {
    name: 'ayoubabed.xyz',
    kind: 'This site',
    line: 'Event galleries with guest uploads, face search, and an Android app.',
    url: 'https://github.com/Today20092/ayoub-linktree-project',
    image: ayoubabedShot,
    alt: 'Event galleries page on ayoubabed.xyz with photo cards and dates',
  },
  {
    name: 'lut_builder',
    kind: 'Camera tool',
    line: 'False-color exposure LUTs for your log profile, built in the browser.',
    url: 'https://today20092.github.io/lut_builder/',
    image: lutBuilderShot,
    alt: 'LUT Builder setup screen with Sony S-Log3 selected',
  },
  {
    name: 'Rate control field guide',
    kind: 'Encoding guide',
    line: 'Interactive guide to H.264 and H.265 rate control modes.',
    url: 'https://today20092.github.io/rate-control-field-guide/',
    image: rateControlShot,
    alt: 'Rate control field guide hero reading Something always has to move',
  },
]

const tools = [
  {
    name: 'podcast-bleed-reducer',
    kind: 'Audio',
    line: 'Removes mic bleed from multitrack podcasts.',
    url: 'https://github.com/Today20092/podcast-bleed-reducer',
    icon: AudioLines,
  },
  {
    name: 'ArchiveBench',
    kind: 'Encoding',
    line: 'Tests encoders on your footage before you archive.',
    url: 'https://github.com/Today20092/ArchiveBench',
    icon: HardDrive,
  },
  {
    name: 'cutnotes',
    kind: 'Review',
    line: 'Timestamped team comments on a cut, self-hosted.',
    url: 'https://github.com/Today20092/cutnotes',
    icon: MessageSquareText,
  },
  {
    name: 'Resolve TimeTracker',
    kind: 'DaVinci Resolve',
    line: 'Logs editing and render time locally.',
    url: 'https://github.com/Today20092/Davinci-Resolve-TimeTracker',
    icon: Timer,
  },
]

const githubIcon = simpleIcons.icons.github.body
const focusRing =
  'focus-visible:ring-ring focus-visible:ring-2 focus-visible:ring-offset-4 focus-visible:outline-none'
---

<section
  id="technical-work"
  aria-labelledby="technical-work-title"
  class="border-border mt-12 scroll-mt-20 border-t pt-8 lg:mt-16 lg:pt-10"
  data-reveal="fade"
>
  <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-3">
    <div class="max-w-xl">
      <h2
        id="technical-work-title"
        class="font-heading text-foreground text-2xl font-extrabold sm:text-3xl"
      >
        Technical work
      </h2>
      <p class="text-muted-foreground mt-2 text-base leading-7">
        Tools I build for my own shoots and edits, plus client websites. Written
        with AI coding agents, reviewed and shipped by me.
      </p>
    </div>
    <a
      href="https://github.com/Today20092"
      target="_blank"
      rel="noopener noreferrer"
      class:list={[
        'text-foreground hover:bg-accent inline-flex min-h-11 items-center gap-2 rounded-sm px-2 text-sm font-bold underline decoration-dotted underline-offset-4 hover:decoration-solid',
        focusRing,
      ]}
    >
      <svg
        class="size-5"
        viewBox="0 0 24 24"
        aria-hidden="true"
        set:html={githubIcon}
      />
      GitHub profile
    </a>
  </div>

  <a
    href="/portfolio/ya-hala-workflow/"
    class:list={[
      'group border-border bg-muted/40 hover:bg-muted mt-6 flex items-center gap-4 rounded-sm border p-4 transition-colors sm:p-5',
      focusRing,
    ]}
    data-reveal="up"
  >
    <span
      class="bg-foreground text-background inline-flex size-10 shrink-0 items-center justify-center rounded-sm"
      aria-hidden="true"
    >
      <Clapperboard size={20} />
    </span>
    <span class="min-w-0 flex-1">
      <small class="text-muted-foreground block text-xs font-semibold tracking-wider uppercase">
        Case study
      </small>
      <strong class="font-heading text-foreground mt-0.5 block text-base font-extrabold">
        How a Ya Hala shoot goes from log footage to final grade
      </strong>
    </span>
    <ArrowUpRight
      size={20}
      aria-hidden="true"
      className="text-muted-foreground group-hover:text-foreground shrink-0 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
    />
  </a>

  <ul class="mt-8 grid gap-x-6 gap-y-8 sm:grid-cols-2">
    {featured.map((project, index) => (
      <li data-reveal="up" style={`--reveal-delay: ${index * 60}ms`}>
        <a
          href={project.url}
          target="_blank"
          rel="noopener noreferrer"
          class:list={['group block rounded-sm', focusRing]}
        >
          <span class="border-border bg-muted block overflow-hidden rounded-sm border">
            <Image
              src={project.image}
              alt={project.alt}
              width={960}
              height={600}
              widths={[480, 720, 960]}
              sizes="(min-width: 640px) 48vw, 100vw"
              fit="cover"
              position="top"
              quality={75}
              class="block aspect-16/10 h-auto w-full object-cover object-top transition-transform duration-300 ease-out group-hover:scale-[1.02]"
            />
          </span>
          <span class="mt-3 flex items-baseline justify-between gap-3">
            <strong class="font-heading text-foreground min-w-0 text-lg leading-6 font-extrabold">
              {project.name}
            </strong>
            <small class="text-muted-foreground shrink-0 text-xs font-semibold tracking-wider uppercase">
              {project.kind}
            </small>
          </span>
          <span class="text-muted-foreground mt-1 block text-sm leading-6">
            {project.line}
          </span>
        </a>
      </li>
    ))}
  </ul>

  <h3 class="text-foreground mt-10 mb-3 text-base font-bold">
    Tools for production and post
  </h3>
  <ul class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
    {tools.map((tool) => (
      <li>
        <a
          href={tool.url}
          target="_blank"
          rel="noopener noreferrer"
          class:list={[
            'group border-border hover:bg-muted/60 flex h-full items-start gap-3 rounded-sm border p-3 transition-colors',
            focusRing,
          ]}
        >
          <span
            class="bg-muted text-foreground inline-flex size-9 shrink-0 items-center justify-center rounded-sm"
            aria-hidden="true"
          >
            <tool.icon size={18} />
          </span>
          <span class="min-w-0">
            <strong class="text-foreground block text-sm leading-5 font-bold wrap-anywhere">
              {tool.name}
            </strong>
            <span class="text-muted-foreground mt-0.5 block text-sm leading-5">
              {tool.line}
            </span>
            <small class="text-muted-foreground mt-1.5 block text-xs font-semibold tracking-wider uppercase">
              {tool.kind}
            </small>
          </span>
        </a>
      </li>
    ))}
  </ul>

  <p class="text-muted-foreground mt-6 flex items-center gap-2 text-sm">
    <GitMerge size={16} aria-hidden="true" className="shrink-0" />
    <span>
      Open source:
      <a
        href="https://github.com/tonyantony300/dashbeam/pulls?q=is%3Apr+author%3AToday20092+is%3Amerged"
        target="_blank"
        rel="noopener noreferrer"
        class="text-foreground font-semibold underline decoration-dotted underline-offset-4 hover:decoration-solid"
      >
        2 merged PRs to Dashbeam
      </a>
      , a file-sharing app.
    </span>
  </p>
</section>
