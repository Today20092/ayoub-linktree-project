---
import GalleryPreferences from './GalleryPreferences'

type Props = { count: number }
const { count } = Astro.props
---

<div
  class="gallery-toolbar border-border bg-background mb-2 flex flex-wrap items-center gap-3 border-b py-3"
  data-gallery-controls
>
  <div class="w-full sm:w-auto sm:self-start">
    <h2 class="text-sm font-bold">
      {count}
      {count === 1 ? ' photo' : ' photos'}
    </h2>
    <p class="text-muted-foreground text-xs">Tap a photo to open</p>
  </div>
  <GalleryPreferences client:load />
  <span class="sr-only" role="status" data-gallery-size-status></span>
</div>
<div class="mb-3 text-sm">
  <p data-gallery-filter-status role="status"></p>
  <button
    type="button"
    data-gallery-show-page
    hidden
    class="min-h-11 underline underline-offset-4"
  >
    Show loaded photos
  </button>
  <button
    type="button"
    data-gallery-filter-retry
    hidden
    class="min-h-11 underline underline-offset-4"
  >
    Retry loading photos
  </button>
</div>

<script>
  import {
    galleryColumns,
    masonryRowSpan,
    parseGalleryPreferences,
  } from '../lib/gallery-grid'

  document
    .querySelectorAll<HTMLElement>('[data-gallery-controls]')
    .forEach((toolbar) => {
      const gallery = toolbar.parentElement
      if (!gallery) return
      const status = toolbar.querySelector<HTMLElement>(
        '[data-gallery-size-status]',
      )!
      let columns = window.innerWidth >= 768 ? 5 : 3
      let view: 'grid' | 'masonry' = 'grid'
      const preferencesKey = `event-gallery:${gallery.id}:layout`
      try {
        const saved = parseGalleryPreferences(
          localStorage.getItem(preferencesKey),
        )
        if (saved) {
          columns = saved.columns
          view = saved.view
        }
      } catch {
        // Browsing still works when storage is unavailable.
      }
      const savePreferences = () => {
        try {
          localStorage.setItem(
            preferencesKey,
            JSON.stringify({ columns, view }),
          )
        } catch {
          // Keep the current settings for this visit when storage is unavailable.
        }
      }
      let position: { element: HTMLElement; top: number } | undefined
      const restorePosition = () => {
        if (!position) return
        window.scrollBy({
          top: position.element.getBoundingClientRect().top - position.top,
          behavior: 'instant',
        })
      }
      for (const event of ['pointerdown', 'touchstart', 'wheel', 'keydown']) {
        document.addEventListener(
          event,
          () => {
            position = undefined
          },
          { passive: true },
        )
      }

      const render = (next: number, keepPlace = false, nextView = view) => {
        const figures = [
          ...gallery.querySelectorAll<HTMLElement>('[data-gallery-filename]'),
        ]
        const toolbarBottom = toolbar.getBoundingClientRect().bottom
        const anchor = keepPlace
          ? figures.find((figure) => {
              const bounds = figure.getBoundingClientRect()
              return (
                !figure.hidden &&
                bounds.bottom > toolbarBottom &&
                bounds.top < window.innerHeight
              )
            })
          : undefined
        const before = anchor?.getBoundingClientRect().top
        view = nextView
        gallery.dataset.galleryView = view
        const levels = galleryColumns(gallery.clientWidth)
        columns = levels.filter((level) => level <= next).at(-1) ?? levels[0]
        gallery.style.setProperty('--gallery-columns', String(columns))
        gallery.dataset.dense = String(columns >= 5)
        const tileWidth = (gallery.clientWidth - (columns - 1) * 2) / columns
        gallery
          .querySelectorAll<HTMLImageElement>('[data-photo-grid] img')
          .forEach((image) => {
            image.style.aspectRatio = `${image.getAttribute('width')} / ${image.getAttribute('height')}`
            image
              .closest('figure')
              ?.style.setProperty(
                '--masonry-span',
                String(
                  masonryRowSpan(
                    Number(image.getAttribute('width')),
                    Number(image.getAttribute('height')),
                    tileWidth,
                  ),
                ),
              )
            image.sizes = `${Math.ceil(tileWidth)}px`
            const source = image.closest('picture')?.querySelector('source')
            if (source) source.sizes = image.sizes
          })
        gallery.dataset.galleryColumns = String(columns)
        gallery.dispatchEvent(new Event('gallery:preferences'))
        status.textContent = `${view === 'grid' ? 'Grid' : 'Natural layout'} view, ${columns} columns`
        if (anchor && before !== undefined) {
          position = { element: anchor, top: before }
          requestAnimationFrame(restorePosition)
        }
      }

      gallery.addEventListener('gallery:size', (event) => {
        const levels = galleryColumns(gallery.clientWidth)
        const next =
          (event as CustomEvent).detail === 'smaller'
            ? levels.find((level) => level > columns)
            : levels.filter((level) => level < columns).at(-1)
        if (next) {
          render(next, true)
          savePreferences()
        }
      })
      gallery.addEventListener('gallery:view', (event) => {
        render(
          columns,
          true,
          (event as CustomEvent).detail === 'masonry' ? 'masonry' : 'grid',
        )
        savePreferences()
      })
      const applyOrder = (order: 'oldest' | 'newest') => {
        if (gallery.dataset.galleryFiltered === 'true') return
        const content = gallery.querySelector<HTMLElement>(
          '[data-gallery-page-content]',
        )!
        const firstSection = content.querySelector(
          order === 'newest' ? 'section' : '[data-gallery-grid]',
        )
        if (firstSection) content.insertBefore(firstSection, content.firstChild)
        gallery
          .querySelectorAll<HTMLElement>('[data-photo-grid]')
          .forEach((grid) => {
            const figures = [...grid.children].filter(
              (child): child is HTMLElement => child instanceof HTMLElement,
            )
            figures.sort((a, b) => {
              const delta =
                Number(
                  a.querySelector<HTMLElement>('[data-gallery-open]')?.dataset
                    .galleryOpen,
                ) -
                Number(
                  b.querySelector<HTMLElement>('[data-gallery-open]')?.dataset
                    .galleryOpen,
                )
              return order === 'newest' ? -delta : delta
            })
            figures.forEach((figure) => grid.appendChild(figure))
          })
      }
      render(columns)
      gallery.addEventListener('gallery:layout', () => {
        position = undefined
        const order =
          gallery.dataset.galleryOrder === 'newest' ? 'newest' : 'oldest'
        applyOrder(order)
        render(columns)
      })
      let width = gallery.clientWidth
      new ResizeObserver(() => {
        if (width !== gallery.clientWidth) {
          width = gallery.clientWidth
          render(columns, true)
        } else {
          // Keep the anchor stable while lazy images finish laying out.
          requestAnimationFrame(restorePosition)
        }
      }).observe(gallery)
    })
</script>

<style is:global>
  [data-gallery-favorites-only='true']
    [data-gallery-filename]:not([data-favorite='true']) {
    display: none;
  }
  [data-gallery-browser] {
    --gallery-columns: 3;
    overflow-anchor: none;
    scroll-margin-top: 12rem;
  }
  [data-photo-grid] {
    display: grid;
    grid-template-columns: repeat(var(--gallery-columns), minmax(0, 1fr));
    gap: 2px;
  }
  [data-photo-grid] > figure {
    min-width: 0;
    margin: 0;
  }
  [data-photo-grid] [data-gallery-open] {
    display: block;
    aspect-ratio: 1;
  }
  [data-photo-grid] img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  [data-gallery-view='masonry'] [data-photo-grid] {
    grid-auto-rows: 1px;
    grid-auto-flow: row;
    align-items: start;
  }
  [data-gallery-view='masonry'] [data-photo-grid] > figure {
    grid-row-end: span var(--masonry-span, 1);
  }
  [data-gallery-view='masonry'] [data-gallery-open] {
    aspect-ratio: auto;
  }
  [data-gallery-view='masonry'] [data-photo-grid] img {
    height: auto;
  }
  [data-gallery-favorite] {
    top: 0;
    right: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--foreground);
    box-shadow: none;
    isolation: isolate;
  }
  [data-gallery-favorite]::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 2rem;
    height: 2rem;
    transform: translate(-50%, -50%);
    border-radius: inherit;
    background: var(--background);
    z-index: -1;
    box-shadow: 0 1px 4px #0003;
  }
  [data-gallery-favorite]:hover {
    background: transparent;
  }
  [data-gallery-browser][data-dense='true'] [data-gallery-favorite] {
    display: none;
  }
  [data-gallery-favorite][data-selected='true'] svg {
    fill: currentColor;
  }
  [data-gallery-browser][data-gallery-has-picks='true'] {
    padding-bottom: var(--gallery-selection-height, 10rem);
  }
  [data-gallery-controls] [data-slot='toggle'] {
    min-height: 2.75rem;
    min-width: 0;
    max-width: 100%;
    flex-wrap: wrap;
    white-space: normal;
  }
  [data-gallery-browser] [data-slot='button']:not([data-gallery-favorite]) {
    max-width: 100%;
    min-width: 0;
    min-height: 2.75rem;
    height: auto;
    padding-block: 0.5rem;
    white-space: normal;
  }
  [data-gallery-controls] [data-slot='toggle'][data-pressed] {
    background: var(--foreground);
    color: var(--background);
  }
  [data-gallery-controls] [data-slot='toggle'][data-pressed] svg {
    opacity: 1;
  }
  @media (hover: hover) and (pointer: fine) {
    [data-gallery-filename]:not(:hover):not(:focus-within)
      [data-gallery-favorite]:not([data-selected='true']) {
      opacity: 0;
    }
  }
  [data-photo-grid] [data-face-rank]:not([hidden]) {
    top: auto;
    bottom: 2px;
    left: 2px;
    padding: 1px 3px;
    font-size: 10px;
    pointer-events: none;
  }
  @media (min-width: 768px) {
    [data-gallery-browser] {
      --gallery-columns: 5;
    }
  }
</style>
