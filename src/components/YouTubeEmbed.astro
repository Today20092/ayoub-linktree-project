---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

type Props = {
  youtubeId: string
  title: string
  poster?: ImageMetadata | string
  posterAlt?: string
  class?: string
}

const {
  youtubeId,
  title,
  poster,
  posterAlt = '',
  class: className,
} = Astro.props
const remotePoster = typeof poster === 'string' ? poster : undefined
const localPoster = typeof poster === 'string' ? undefined : poster
---

<div
  class:list={[
    'youtube-embed bg-muted relative aspect-video overflow-hidden',
    className,
  ]}
  data-youtube-embed
  data-youtube-id={youtubeId}
  data-youtube-title={title}
>
  {
    remotePoster ? (
      <Image
        src={remotePoster}
        alt={posterAlt}
        width={1280}
        height={720}
        layout="full-width"
        widths={[640, 960, 1280]}
        sizes="(min-width: 1280px) 1216px, 100vw"
        quality={80}
        priority
        class="absolute inset-0 size-full object-cover"
        data-youtube-poster
      />
    ) : localPoster ? (
      <Image
        src={localPoster}
        alt={posterAlt}
        width={1280}
        height={720}
        layout="full-width"
        widths={[640, 960, 1280]}
        sizes="(min-width: 1280px) 1216px, 100vw"
        quality={80}
        priority
        class="absolute inset-0 size-full object-cover"
        data-youtube-poster
      />
    ) : null
  }
  <div
    class="absolute inset-0 flex items-center justify-center"
    data-youtube-player
  >
    <button
      type="button"
      aria-label={`Play ${title}`}
      class="absolute inset-0 flex cursor-pointer items-center justify-center focus-visible:outline-4 focus-visible:-outline-offset-4 focus-visible:outline-white"
      data-youtube-play
    >
      <span
        class="rounded-full bg-black/80 px-6 py-4 text-lg font-bold text-white"
      >
        ▶ Play
      </span>
    </button>
  </div>
</div>
<a
  href={`https://www.youtube.com/watch?v=${youtubeId}`}
  class="text-primary mt-2 inline-block text-sm underline underline-offset-4"
  aria-label={`Watch ${title} on YouTube`}
>
  Watch on YouTube
</a>

<script>
  const initializeYouTubeEmbeds = () => {
    const loadEmbed = (embed: HTMLElement) => {
      if (embed.dataset.youtubeLoaded === 'true') return

      const youtubeId = embed.dataset.youtubeId
      const title = embed.dataset.youtubeTitle
      const player = embed.querySelector<HTMLElement>('[data-youtube-player]')
      const poster = embed.querySelector<HTMLElement>('[data-youtube-poster]')

      if (!youtubeId || !title || !player) return

      const params = new URLSearchParams({
        autoplay: '1',
        playsinline: '1',
        controls: '1',
        rel: '0',
      })
      const iframe = document.createElement('iframe')

      iframe.src = `https://www.youtube-nocookie.com/embed/${youtubeId}?${params}`
      iframe.title = title
      iframe.className = 'absolute inset-0 size-full border-0 opacity-0'
      iframe.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share'
      iframe.referrerPolicy = 'strict-origin-when-cross-origin'
      iframe.allowFullscreen = true
      iframe.addEventListener(
        'load',
        () => {
          iframe.classList.remove('opacity-0')
          poster?.classList.add('invisible')
        },
        { once: true },
      )

      player.replaceChildren(iframe)
      embed.dataset.youtubeLoaded = 'true'
      iframe.focus()
    }

    const embeds = document.querySelectorAll<HTMLElement>(
      '[data-youtube-embed]:not([data-youtube-loaded="true"])',
    )

    embeds.forEach((embed) => {
      embed
        .querySelector<HTMLButtonElement>('[data-youtube-play]')
        ?.addEventListener('click', () => loadEmbed(embed), { once: true })
    })
  }

  initializeYouTubeEmbeds()
</script>
