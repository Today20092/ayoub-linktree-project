---
import CloudflareWebAnalytics from '../components/CloudflareWebAnalytics.astro'
import Header from '../components/Header.astro'
import { Font } from 'astro:assets'
import { cacheControlForPage } from '../lib/public-delivery'
import {
  PRIVATE_PAGE_ROBOTS,
  applyPrivatePageHeaders,
} from '../lib/private-page'
import { publicRoutes, type NavKey } from '../lib/public-routes'
import { siteConfig } from '../lib/site-config'

type Props = {
  title: string
  description: string
  canonicalUrl: string
  ogTitle?: string
  ogDescription?: string
  /** Defaults to the site share image; omit it and the dimensions and type follow. */
  ogImage?: string
  ogImageAlt?: string
  ogType?: 'website' | 'article'
  ogImageWidth?: number
  ogImageHeight?: number
  ogImageType?: string
  twitterHandle?: string
  robots?: string
  sitemapUrl?: string
  preconnectHints?: string[]
  structuredData?: Record<string, unknown>
  activeNav?: NavKey
  disableAnalytics?: boolean
  minimal?: boolean
  /** Secret-link or admin page: noindex, no-store, no-referrer, no analytics. */
  privatePage?: boolean
}

const {
  title,
  description,
  canonicalUrl,
  ogTitle = title,
  ogDescription = description,
  ogImage: customOgImage,
  ogImageAlt: customOgImageAlt,
  ogType = 'website',
  ogImageWidth: customOgImageWidth,
  ogImageHeight: customOgImageHeight,
  ogImageType: customOgImageType,
  twitterHandle,
  robots:
    customRobots = 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1',
  sitemapUrl,
  preconnectHints = [],
  structuredData,
  activeNav,
  disableAnalytics: customDisableAnalytics = false,
  minimal = false,
  privatePage = false,
} = Astro.props as Props

const { site } = siteConfig
const isDefaultOgImage = !customOgImage
const ogImage = customOgImage ?? new URL(site.ogImage, Astro.site).toString()
const ogImageAlt =
  customOgImageAlt ?? (isDefaultOgImage ? site.ogImageAlt : undefined)
const ogImageWidth =
  customOgImageWidth ?? (isDefaultOgImage ? site.ogImageWidth : 1200)
const ogImageHeight =
  customOgImageHeight ?? (isDefaultOgImage ? site.ogImageHeight : 630)
const ogImageType =
  customOgImageType ?? (isDefaultOgImage ? site.ogImageType : undefined)
const robots = privatePage ? PRIVATE_PAGE_ROBOTS : customRobots
const disableAnalytics = privatePage || customDisableAnalytics

// Set before the cache helper below so it sees no-store and stays out of the way.
if (privatePage) applyPrivatePageHeaders(Astro.response.headers)

const pageCacheControl = cacheControlForPage(
  Astro.url,
  Astro.request,
  Astro.response.headers,
)
if (pageCacheControl)
  Astro.response.headers.set('Cache-Control', pageCacheControl)

const themeScript = `;(() => {
  const systemQuery = window.matchMedia('(prefers-color-scheme: dark)')

  const applyTheme = () => {
    const isDark = systemQuery.matches
    document.documentElement.classList.toggle('dark', isDark)
    document.documentElement.style.colorScheme = isDark ? 'dark' : 'light'
  }

  applyTheme()
  systemQuery.addEventListener('change', applyTheme)
  document.documentElement.dataset.revealReady = 'true'
})()`

if (Astro.csp) {
  const digest = await crypto.subtle.digest(
    'SHA-256',
    new TextEncoder().encode(themeScript),
  )
  const hash = btoa(String.fromCharCode(...new Uint8Array(digest)))
  Astro.csp.insertScriptHash(`sha256-${hash}`)
}
---

<!doctype html>
<html lang="en" class="box-border">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {sitemapUrl && <link rel="sitemap" href={sitemapUrl} />}
    {preconnectHints.map((href) => (
      <link rel="preconnect" href={href} />
    ))}
    <Font cssVariable="--font-jakarta" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-zodiak" preload={[{ style: 'normal' }]} />
    <slot name="head" />

    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#1c1917"
      media="(prefers-color-scheme: dark)"
    />

    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImage} />
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    {ogImageType && <meta property="og:image:type" content={ogImageType} />}
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Ayoub Abedrabbo" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    {twitterHandle && <meta name="twitter:site" content={twitterHandle} />}
    {twitterHandle && <meta name="twitter:creator" content={twitterHandle} />}
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    {ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="text/markdown" href="/index.md" />

    <script is:inline set:html={themeScript} />
    {structuredData && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(structuredData)}
      />
    )}
    {!disableAnalytics && <CloudflareWebAnalytics />}
  </head>
  <body class="bg-background text-foreground flex min-h-[100dvh] flex-col subpixel-antialiased">
    <a
      href="#main-content"
      class="bg-background text-foreground focus-visible:ring-ring fixed top-3 left-3 z-50 -translate-y-20 rounded-sm px-4 py-2 font-bold shadow-md focus:translate-y-0 focus-visible:ring-2 focus-visible:outline-none"
    >
      Skip to content
    </a>
    {!minimal && <Header activeNav={activeNav} />}
    <slot />
    {!minimal && (
      <footer class="text-muted-foreground mx-auto mt-auto flex w-full max-w-screen-2xl shrink-0 flex-wrap justify-center gap-4 px-4 py-8 text-xs sm:px-6 lg:px-8">
        {publicRoutes
          .filter((route) => route.footer)
          .map((route) => (
            <a
              class="link-quiet inline-flex min-h-11 items-center px-2"
              href={route.path}
            >
              {route.label}
            </a>
          ))}
      </footer>
    )}
    <script>
      const revealItems = Array.from(
        document.querySelectorAll<HTMLElement>('[data-reveal]'),
      )
      const reducedMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)',
      )
      const showRevealItem = (item: HTMLElement) => {
        item.dataset.revealVisible = 'true'
      }

      if (revealItems.length > 0) {
        if (reducedMotion.matches || !('IntersectionObserver' in window)) {
          revealItems.forEach(showRevealItem)
        } else {
          const revealObserver = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return
                showRevealItem(entry.target as HTMLElement)
                revealObserver.unobserve(entry.target)
              })
            },
            { rootMargin: '0px 0px 20%', threshold: 0.05 },
          )

          revealItems.forEach((item) => revealObserver.observe(item))
        }
      }
    </script>
  </body>
</html>
