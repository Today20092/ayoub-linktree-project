---
import '../styles.css'
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout
  title="Page not found | Ayoub Abedrabbo"
  description="This page could not be found. Browse the website or find an event gallery."
  canonicalUrl={new URL('/404/', Astro.site).toString()}
  ogImage="/og-ayoub-digital-media.jpg"
  robots="noindex,nofollow"
  disableAnalytics
>
  <main id="main-content" class="mx-auto w-full max-w-3xl px-4 py-12 sm:px-6">
    <p class="text-muted-foreground text-sm">404</p>
    <h1 class="font-heading mt-3 text-4xl font-bold">Page not found</h1>
    <p class="text-muted-foreground mt-5 leading-7">
      This page may have moved, or the link may be incomplete. If you received a
      private gallery link, ask the host for the complete link.
    </p>
    <nav aria-label="Find another page" class="mt-6 flex flex-wrap gap-4">
      <a
        href="/"
        class="text-link inline-flex min-h-11 items-center underline underline-offset-4"
      >
        Go to the homepage
      </a>
      <a
        href="/galleries/"
        class="text-link inline-flex min-h-11 items-center underline underline-offset-4"
      >
        Browse event galleries
      </a>
    </nav>
  </main>
</BaseLayout>
