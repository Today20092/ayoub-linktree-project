---
import '../styles.css'

import { Image } from 'astro:assets'

import angelPortrait from '../assets/portraits/angel-birthday-cover.jpg'
import BaseLayout from '../layouts/BaseLayout.astro'
import { eventPortraitPath } from '../lib/event-portrait-offer'
import { getBaseUrl, resolveSiteAsset, siteConfig } from '../lib/site-config'

const servicePageTitle = 'Services | Ayoub Abedrabbo'
const servicePageDescription =
  'Event photography in Tampa starting at $400, and video by custom quote.'

const { twitterHandle, ogImage, ogImageAlt } = siteConfig.site
const baseUrl = getBaseUrl(import.meta.env.BASE_URL)
const canonicalUrl = new URL(`${baseUrl}services/`, Astro.site).toString()
const ogImageUrl = new URL(
  resolveSiteAsset(baseUrl, ogImage),
  Astro.site,
).toString()
const link =
  'text-primary rounded-sm font-medium underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4'
---

<BaseLayout
  title={servicePageTitle}
  description={servicePageDescription}
  canonicalUrl={canonicalUrl}
  ogImage={ogImageUrl}
  ogImageAlt={ogImageAlt}
  twitterHandle={twitterHandle}
  activeNav="services"
>
  <main
    id="main-content"
    class="mx-auto w-full max-w-screen-lg self-center px-4 py-10 sm:px-6 sm:py-14 lg:px-8"
  >
    <h1 class="font-heading text-4xl font-extrabold tracking-tight text-balance sm:text-5xl">
      Services
    </h1>
    <p class="text-muted-foreground mt-4 max-w-xl text-lg leading-8">
      Event photography with a live gallery, and video for organizations in
      Tampa.
    </p>
    <ul class="mt-10 divide-y border-y">
      <li class="flex items-center gap-5 py-5">
        <Image
          src={angelPortrait}
          alt="Angel celebrating his birthday with family around the cake"
          width={160}
          widths={[160, 320]}
          sizes="160px"
          class="aspect-[4/3] w-24 shrink-0 rounded-xl object-cover sm:w-40"
        />
        <div class="flex min-w-0 flex-1 flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
          <h2 class="text-lg font-semibold">
            <a href={eventPortraitPath} class={link}>
              Event photography
            </a>
          </h2>
          <p class="font-bold tabular-nums">Starting at $400</p>
        </div>
      </li>
      <li class="flex items-center gap-5 py-5">
        <div class="flex min-w-0 flex-1 flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
          <h2 class="text-lg font-semibold">
            <a href="/contact/" class={link}>
              Video
            </a>
          </h2>
          <p class="font-bold">Custom quote</p>
        </div>
      </li>
    </ul>
  </main>
</BaseLayout>
