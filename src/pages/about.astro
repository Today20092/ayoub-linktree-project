---
import '../styles.css'

import BaseLayout from '../layouts/BaseLayout.astro'
import { siteConfig } from '../lib/site-config'

const { site } = siteConfig
const title = 'About Ayoub Abedrabbo | Digital Media Specialist'
const description =
  'Learn about Ayoub Abedrabbo, a Tampa digital media specialist working across video, photography, marketing, and education.'
const canonicalUrl = new URL('/about/', Astro.site).toString()
const ogImage = new URL('/og-ayoub-digital-media.jpg', Astro.site).toString()
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  ogImage={ogImage}
  ogImageWidth={1200}
  ogImageHeight={630}
  ogImageType="image/jpeg"
  ogImageAlt={site.ogImageAlt}
  activeNav="about"
>
  <main
    id="main-content"
    class="mx-auto w-full max-w-3xl scroll-mt-20 px-4 py-10 sm:px-6 sm:py-14 lg:px-8 lg:py-20"
  >
    <header data-reveal="up">
      <p class="text-primary text-sm font-bold tracking-wide uppercase">
        About
      </p>
      <h1
        class="font-heading mt-3 text-4xl leading-none font-extrabold tracking-tight sm:text-5xl"
      >
        Ayoub Abedrabbo
      </h1>
      <p class="text-muted-foreground mt-5 text-lg leading-8">
        {site.pageDescription}
      </p>
    </header>
    <div class="mt-10 space-y-8 text-base leading-8" data-reveal="up">
      <p>
        I work with businesses, schools, mosques, nonprofits, and community
        organizations in the Tampa area. My work includes photography,
        videography, podcast production, editing, color, audio, and practical
        digital media education.
      </p>
      <p>
        This site collects selected portfolio projects and public event
        galleries in one place. Browse the <a
          class="underline underline-offset-4"
          href="/galleries/"
        >
          event galleries
        </a>, view the <a class="underline underline-offset-4" href="/">
          portfolio
        </a>, or <a class="underline underline-offset-4" href="/contact/">
          contact me
        </a>.
      </p>
    </div>
  </main>
</BaseLayout>
