---
import '../../styles.css'
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import { buttonVariants } from '@/components/ui/button'
import { Separator } from '@/components/ui/separator'
import BaseLayout from '../../layouts/BaseLayout.astro'
import {
  eventPortraitDescription,
  eventPortraitPackages,
  eventPortraitPhone,
  eventPortraitStructuredData,
  eventPortraitTitle,
} from '../../lib/event-portrait-offer'
import { siteConfig } from '../../lib/site-config'

const portraitAssets = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/portraits/angel-birthday-cover.jpg',
  { eager: true },
)
const angelPortrait =
  portraitAssets['../../assets/portraits/angel-birthday-cover.jpg'].default

const title = eventPortraitTitle
const description = eventPortraitDescription
const canonicalUrl = new URL(
  '/services/event-portraits/',
  Astro.site,
).toString()
const ogImage = new URL(siteConfig.site.ogImage, Astro.site).toString()
const packages = eventPortraitPackages
---

<BaseLayout
  activeNav="portraits"
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  ogImage={ogImage}
  ogImageWidth={siteConfig.site.ogImageWidth}
  ogImageHeight={siteConfig.site.ogImageHeight}
  ogImageType={siteConfig.site.ogImageType}
  ogImageAlt={siteConfig.site.ogImageAlt}
  twitterHandle={siteConfig.site.twitterHandle}
  structuredData={eventPortraitStructuredData(canonicalUrl)}
>
  <main
    id="main-content"
    class="mx-auto w-full max-w-screen-2xl self-center px-4 sm:px-6 lg:px-8"
  >
    <section
      aria-labelledby="experience-title"
      class="grid items-center gap-8 py-10 sm:py-14 lg:grid-cols-2 lg:gap-16 lg:py-20"
    >
      <div class="min-w-0">
        <h1
          id="experience-title"
          class="font-heading text-4xl leading-[1.08] font-extrabold tracking-tight text-balance sm:text-5xl lg:text-6xl"
        >
          Your event. A gallery within minutes.
        </h1>
        <p class="mt-6 max-w-lg text-lg leading-8">
          From $400. Angel’s birthday gallery was updating during the party.
        </p>
        <p class="text-muted-foreground mt-4 max-w-lg text-lg leading-8">
          Book Ayoub for the event in Tampa. The host pays. Guests receive the
          photos at no charge.
        </p>
        <div class="mt-7 flex flex-wrap items-center gap-5">
          <a
            href="#inquiry"
            class={`${buttonVariants({ size: 'lg' })} min-h-11 px-5`}
          >
            Request a quote
          </a>
          <a
            href="#pricing"
            class="text-primary rounded-sm text-sm font-medium underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4"
          >
            View pricing
          </a>
        </div>
      </div>
      <figure class="min-w-0">
        <Image
          src={angelPortrait}
          alt="Angel celebrating his birthday with family around the cake"
          layout="full-width"
          widths={[480, 720, 1080]}
          sizes="(min-width: 1024px) 520px, (min-width: 640px) 90vw, 100vw"
          loading="eager"
          fetchpriority="high"
          quality={82}
          class="aspect-[4/3] rounded-2xl object-cover"
        />
        <figcaption class="text-muted-foreground mt-3 text-sm leading-6">
          Angel’s birthday party, October 24, 2026.
          <a
            href="/galleries/angels-birthday-party-2026/"
            class="text-primary rounded-sm font-medium underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4"
          >
            See the gallery
          </a>
        </figcaption>
      </figure>
    </section>

    <Separator />

    <section
      aria-labelledby="guest-experience-title"
      class="scroll-mt-24 py-10 sm:py-14"
    >
      <div class="max-w-2xl">
        <h2
          id="guest-experience-title"
          class="font-heading text-2xl font-bold tracking-tight sm:text-3xl"
        >
          What you get
        </h2>
        <p class="text-muted-foreground mt-4 max-w-xl leading-7">
          Guests open a link on their phone. Each photo shows up within minutes
          of being taken, and guests do not pay.
        </p>
        <p class="mt-4 text-sm leading-6">
          <a
            href="/galleries/angels-birthday-party-2026/"
            class="text-primary rounded-sm font-medium underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4"
          >
            Angel’s gallery
          </a>
          <span class="text-muted-foreground px-1.5">·</span>
          <a
            href="/portfolio/portraits/"
            class="text-primary rounded-sm font-medium underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4"
          >
            Portrait portfolio
          </a>
        </p>
      </div>
    </section>

    <Separator />

    <section
      id="pricing"
      aria-labelledby="pricing-title"
      class="scroll-mt-24 py-10 sm:py-14"
    >
      <h2
        id="pricing-title"
        class="font-heading text-2xl font-bold tracking-tight sm:text-3xl"
      >
        Starting prices
      </h2>
      <p class="text-muted-foreground mt-4 max-w-2xl leading-7">
        Ayoub, camera, and lighting. Prices are starting points.
      </p>
      <div class="mt-8 w-full max-w-lg">
        <div class="text-muted-foreground flex justify-between px-4 pb-3 text-xs font-medium">
          <span>Coverage</span>
          <span>Starting at</span>
        </div>
        <ul class="grid gap-2">
          {packages.map((option) => (
            <li>
              <button
                type="button"
                data-coverage={option.hours}
                aria-pressed="false"
                class="bg-muted/50 hover:bg-muted focus-visible:outline-ring aria-pressed:ring-primary flex w-full items-center justify-between gap-4 rounded-xl px-4 py-4 text-left aria-pressed:ring-2 focus-visible:outline-2 focus-visible:outline-offset-2"
              >
                <span>
                  <span class="block text-sm font-semibold sm:text-base">
                    {option.hours}
                  </span>
                  <span class="mt-1 block text-sm">
                    Planning pace: {option.sessions.toLowerCase()} an hour, not
                    a cap
                  </span>
                </span>
                <span class="shrink-0 text-xl font-bold tracking-tight tabular-nums sm:text-2xl">
                  {option.price}
                </span>
              </button>
            </li>
          ))}
        </ul>
        <div class="mt-4 grid gap-1 px-4 text-sm leading-6">
          <p>Extra hour +$150.</p>
          <p>Travel is included within 30 miles of Tampa.</p>
          <p class="text-muted-foreground">
            Farther travel, a helper, a backdrop, a same-night highlight, and a
            rush gallery are quoted separately. Up to 8 hours is a custom quote.
          </p>
        </div>
      </div>
    </section>

    <Separator />

    <section
      id="inquiry"
      aria-labelledby="inquiry-title"
      class="scroll-mt-24 py-10 sm:py-14"
    >
      <div class="grid items-start gap-8 lg:grid-cols-2 lg:gap-16">
        <div>
          <h2
            id="inquiry-title"
            class="font-heading text-2xl font-bold tracking-tight sm:text-3xl"
          >
            Request a quote
          </h2>
          <p class="text-muted-foreground mt-4 max-w-md leading-7">
            Opens an email draft to Ayoub. Required fields are marked. This does
            not reserve the date.
          </p>
        </div>
        <div>
          <form id="event-portrait-inquiry" class="grid gap-5" novalidate>
            <div
              id="inquiry-errors"
              class="border-destructive bg-destructive/10 text-destructive hidden rounded-xl border px-4 py-3 text-sm"
              tabindex="-1"
              role="alert"
            ></div>
            <fieldset class="grid gap-4">
              <legend class="text-sm font-semibold">The event</legend>
              <div class="grid gap-5 sm:grid-cols-2">
                <label class="grid gap-2 text-sm font-medium" for="coverage">
                  <span class="flex items-baseline justify-between gap-3">
                    Coverage
                    <span class="text-muted-foreground text-xs font-normal">
                      Required
                    </span>
                  </span>
                  <select
                    id="coverage"
                    name="coverage"
                    required
                    aria-describedby="error-coverage"
                    class="border-input bg-background aria-invalid:border-destructive min-h-11 rounded-xl border px-3"
                  >
                    <option value="">Choose coverage</option>
                    {packages.map((option) => (
                      <option value={option.hours}>
                        {option.hours}, starting at {option.price}
                      </option>
                    ))}
                  </select>
                  <p
                    id="error-coverage"
                    class="text-destructive hidden text-sm"
                  ></p>
                </label>
                <label class="grid gap-2 text-sm font-medium" for="extraTime">
                  <span class="flex items-baseline justify-between gap-3">
                    Longer coverage
                    <span class="text-muted-foreground text-xs font-normal">
                      Optional
                    </span>
                  </span>
                  <input
                    id="extraTime"
                    name="extraTime"
                    class="border-input bg-background min-h-11 rounded-xl border px-3"
                    placeholder="Up to 8 hours"
                  />
                </label>
              </div>
              <div class="grid gap-5 sm:grid-cols-2">
                <label class="grid gap-2 text-sm font-medium" for="date">
                  <span class="flex items-baseline justify-between gap-3">
                    Date
                    <span class="text-muted-foreground text-xs font-normal">
                      Required
                    </span>
                  </span>
                  <input
                    id="date"
                    name="date"
                    type="date"
                    required
                    aria-describedby="error-date"
                    class="border-input bg-background aria-invalid:border-destructive min-h-11 rounded-xl border px-3"
                  />
                  <p
                    id="error-date"
                    class="text-destructive hidden text-sm"
                  ></p>
                </label>
                <label class="grid gap-2 text-sm font-medium" for="guests">
                  <span class="flex items-baseline justify-between gap-3">
                    Guests
                    <span class="text-muted-foreground text-xs font-normal">
                      Required
                    </span>
                  </span>
                  <input
                    id="guests"
                    name="guests"
                    type="number"
                    min="1"
                    step="1"
                    inputmode="numeric"
                    required
                    aria-describedby="error-guests"
                    class="border-input bg-background aria-invalid:border-destructive min-h-11 rounded-xl border px-3"
                  />
                  <p
                    id="error-guests"
                    class="text-destructive hidden text-sm"
                  ></p>
                </label>
              </div>
              <div class="grid gap-5 sm:grid-cols-2">
                <label class="grid gap-2 text-sm font-medium" for="venue">
                  <span class="flex items-baseline justify-between gap-3">
                    Venue
                    <span class="text-muted-foreground text-xs font-normal">
                      Required
                    </span>
                  </span>
                  <input
                    id="venue"
                    name="venue"
                    required
                    aria-describedby="error-venue"
                    class="border-input bg-background aria-invalid:border-destructive min-h-11 rounded-xl border px-3"
                  />
                  <p
                    id="error-venue"
                    class="text-destructive hidden text-sm"
                  ></p>
                </label>
                <label class="grid gap-2 text-sm font-medium" for="city">
                  <span class="flex items-baseline justify-between gap-3">
                    City
                    <span class="text-muted-foreground text-xs font-normal">
                      Required
                    </span>
                  </span>
                  <input
                    id="city"
                    name="city"
                    autocomplete="address-level2"
                    required
                    aria-describedby="error-city"
                    class="border-input bg-background aria-invalid:border-destructive min-h-11 rounded-xl border px-3"
                  />
                  <p
                    id="error-city"
                    class="text-destructive hidden text-sm"
                  ></p>
                </label>
              </div>
              <label class="grid gap-2 text-sm font-medium" for="eventType">
                <span class="flex items-baseline justify-between gap-3">
                  Event type
                  <span class="text-muted-foreground text-xs font-normal">
                    Required
                  </span>
                </span>
                <input
                  id="eventType"
                  name="eventType"
                  required
                  aria-describedby="error-eventType"
                  class="border-input bg-background aria-invalid:border-destructive min-h-11 rounded-xl border px-3"
                  placeholder="Birthday, mosque, school, or nonprofit"
                />
                <p
                  id="error-eventType"
                  class="text-destructive hidden text-sm"
                ></p>
              </label>
            </fieldset>
            <fieldset class="grid gap-4">
              <legend class="text-sm font-semibold">How to reach you</legend>
              <div class="grid gap-5 sm:grid-cols-2">
                <label class="grid gap-2 text-sm font-medium" for="name">
                  <span class="flex items-baseline justify-between gap-3">
                    Name
                    <span class="text-muted-foreground text-xs font-normal">
                      Required
                    </span>
                  </span>
                  <input
                    id="name"
                    name="name"
                    autocomplete="name"
                    required
                    aria-describedby="error-name"
                    class="border-input bg-background aria-invalid:border-destructive min-h-11 rounded-xl border px-3"
                  />
                  <p
                    id="error-name"
                    class="text-destructive hidden text-sm"
                  ></p>
                </label>
                <label class="grid gap-2 text-sm font-medium" for="phone">
                  <span class="flex items-baseline justify-between gap-3">
                    Phone
                    <span class="text-muted-foreground text-xs font-normal">
                      Required
                    </span>
                  </span>
                  <input
                    id="phone"
                    name="phone"
                    type="tel"
                    autocomplete="tel"
                    required
                    aria-describedby="error-phone"
                    class="border-input bg-background aria-invalid:border-destructive min-h-11 rounded-xl border px-3"
                  />
                  <p
                    id="error-phone"
                    class="text-destructive hidden text-sm"
                  ></p>
                </label>
                <label class="grid gap-2 text-sm font-medium" for="email">
                  <span class="flex items-baseline justify-between gap-3">
                    Email
                    <span class="text-muted-foreground text-xs font-normal">
                      Required
                    </span>
                  </span>
                  <input
                    id="email"
                    name="email"
                    type="email"
                    enterkeyhint="done"
                    autocomplete="email"
                    required
                    aria-describedby="error-email"
                    class="border-input bg-background aria-invalid:border-destructive min-h-11 rounded-xl border px-3"
                  />
                  <p
                    id="error-email"
                    class="text-destructive hidden text-sm"
                  ></p>
                </label>
              </div>
            </fieldset>
            <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
              <a
                class="text-foreground text-sm underline underline-offset-4"
                href="tel:+18134240606"
              >
                {eventPortraitPhone}
              </a>
              <p id="inquiry-selection" class="text-sm font-medium" hidden></p>
              <button
                type="submit"
                class={buttonVariants({
                  size: 'lg',
                  className: 'min-h-11 px-5',
                })}
              >
                Open email draft
              </button>
              <a
                href="/contact/"
                class="text-primary rounded-sm text-sm font-medium underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4"
              >
                Or use the contact page
              </a>
            </div>
          </form>
          <div
            id="inquiry-ready"
            class="mt-6 hidden rounded-2xl bg-muted/50 p-6"
            role="status"
          >
            <h3 class="text-lg font-semibold">
              Request ready for Ayoub to review.
            </h3>
            <p
              id="inquiry-ready-copy"
              class="text-muted-foreground mt-2 text-sm leading-6"
            ></p>
            <p class="mt-3 text-sm leading-6">
              This does not reserve the date, and this page does not send the
              email itself.
            </p>
            <a
              id="inquiry-mailto"
              class="text-primary mt-4 inline-flex min-h-11 items-center text-sm font-medium underline underline-offset-4"
              href=""
            >
              Open the email draft again
            </a>
          </div>
        </div>
      </div>
    </section>
    <script>
      import {
        inquiryErrors,
        inquiryMailto,
      } from '../../lib/event-portrait-inquiry'

      const form = document.querySelector('#event-portrait-inquiry')
      const errors = document.querySelector('#inquiry-errors')
      const ready = document.querySelector('#inquiry-ready')
      const readyCopy = document.querySelector('#inquiry-ready-copy')
      const mailtoLink = document.querySelector('#inquiry-mailto')
      const coverage = document.querySelector('#coverage')
      const selection = document.querySelector('#inquiry-selection')
      const fieldNames = [
        'coverage',
        'date',
        'venue',
        'city',
        'guests',
        'eventType',
        'name',
        'phone',
        'email',
      ]
      const clearFieldErrors = () => {
        for (const name of fieldNames) {
          document.getElementById(name)?.removeAttribute('aria-invalid')
          const message = document.getElementById(`error-${name}`)
          if (message) {
            message.hidden = true
            message.textContent = ''
          }
        }
      }
      const showFieldErrors = (
        problems: Partial<Record<(typeof fieldNames)[number], string>>,
      ) => {
        clearFieldErrors()
        let first: HTMLElement | null = null
        for (const name of fieldNames) {
          const message = problems[name]
          if (!message) continue
          const field = document.getElementById(name)
          const slot = document.getElementById(`error-${name}`)
          field?.setAttribute('aria-invalid', 'true')
          if (slot) {
            slot.hidden = false
            slot.textContent = message
          }
          if (!first && field) first = field
        }
        first?.focus()
      }
      const showSelection = () => {
        if (
          !(coverage instanceof HTMLSelectElement) ||
          !(selection instanceof HTMLElement)
        ) {
          return
        }
        const label = coverage.selectedOptions[0]?.textContent?.trim() ?? ''
        document.querySelectorAll('[data-coverage]').forEach((button) => {
          if (!(button instanceof HTMLButtonElement)) return
          button.setAttribute(
            'aria-pressed',
            button.dataset.coverage === coverage.value ? 'true' : 'false',
          )
        })
        if (!coverage.value || !label) {
          selection.hidden = true
          selection.textContent = ''
          return
        }
        selection.hidden = false
        selection.textContent = label
      }
      coverage?.addEventListener('change', showSelection)
      document.querySelectorAll('[data-coverage]').forEach((button) => {
        button.addEventListener('click', () => {
          if (
            !(button instanceof HTMLButtonElement) ||
            !(coverage instanceof HTMLSelectElement)
          ) {
            return
          }
          coverage.value = button.dataset.coverage ?? ''
          showSelection()
          selection.scrollIntoView({ block: 'nearest' })
        })
      })
      form?.addEventListener('submit', (event) => {
        event.preventDefault()
        if (
          !(form instanceof HTMLFormElement) ||
          !(errors instanceof HTMLElement) ||
          !(ready instanceof HTMLElement) ||
          !(readyCopy instanceof HTMLElement) ||
          !(mailtoLink instanceof HTMLAnchorElement)
        ) {
          return
        }
        const data = new FormData(form)
        const fields = {
          coverage: String(data.get('coverage') ?? ''),
          extraTime: String(data.get('extraTime') ?? ''),
          date: String(data.get('date') ?? ''),
          venue: String(data.get('venue') ?? ''),
          city: String(data.get('city') ?? ''),
          guests: String(data.get('guests') ?? ''),
          eventType: String(data.get('eventType') ?? ''),
          name: String(data.get('name') ?? ''),
          phone: String(data.get('phone') ?? ''),
          email: String(data.get('email') ?? ''),
        }
        const packages = [...form.querySelectorAll('option')]
          .filter((option) => option.value !== '')
          .map((option) => {
            const price = option.textContent?.split('starting at ')[1]?.trim()
            return { hours: option.value, price: price ?? '' }
          })
        const problems = inquiryErrors(fields, packages)
        const messages = Object.values(problems)
        if (messages.length > 0) {
          errors.classList.remove('hidden')
          errors.textContent =
            messages.length === 1
              ? messages[0]
              : `Check ${messages.length} fields.`
          ready.classList.add('hidden')
          showFieldErrors(problems)
          return
        }
        const href = inquiryMailto(fields, packages)
        const selected = packages.find(
          (option) => option.hours === fields.coverage,
        )
        clearFieldErrors()
        errors.classList.add('hidden')
        ready.classList.remove('hidden')
        readyCopy.textContent = `${fields.coverage}, starting at ${selected?.price}.`
        mailtoLink.href = href
        mailtoLink.click()
      })
    </script>
  </main>
</BaseLayout>
