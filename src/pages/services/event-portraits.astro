---
import '../../styles.css'
import { Image, getImage } from 'astro:assets'
import { Check } from 'lucide-react'
import { getEntry } from 'astro:content'
import { buttonVariants } from '@/components/ui/button'
import { Field, FieldGroup, FieldLabel } from '@/components/ui/field'
import { inputClassName } from '@/components/ui/input'
import { Separator } from '@/components/ui/separator'
import BaseLayout from '../../layouts/BaseLayout.astro'
import PageContainer from '../../components/layout/PageContainer.astro'
import ServiceSection from '../../components/layout/ServiceSection.astro'
import angelPortrait from '../../assets/portraits/angel-birthday-cover.jpg'
import type { ImageMetadata } from 'astro'
import {
  eventPortraitDescription,
  eventPortraitExtraHour,
  eventPortraitOffer,
  eventPortraitProofGalleryUrl,
  eventPortraitTitle,
} from '../../lib/event-portrait-offer'
import {
  formatUsd,
  headlineStartingPrice,
  inquiryEmail,
  mapsListingUrl,
  offerStructuredData,
} from '../../lib/service-offer'
import {
  inquiryFieldDefs,
  type InquiryFieldDef,
  type InquiryFieldName,
} from '../../lib/event-portrait-inquiry'
import { siteConfig } from '../../lib/site-config'

const mcc = await getEntry('portfolio', 'muslim-business-chamber-2026')
if (!mcc) throw new Error('Missing MCC workshop portfolio entry')
const mccImage = mcc.data.featuredImage
const suitPortrait = Object.values(
  import.meta.glob<{ default: ImageMetadata }>(
    '../../assets/portraits/P1210377.JPG',
    { eager: true },
  ),
)[0].default

const title = eventPortraitTitle
const description = eventPortraitDescription
const canonicalUrl = new URL(
  '/services/event-portraits/',
  Astro.site,
).toString()
const packages = eventPortraitOffer.startingPrices.map(({ name, price }) => ({
  hours: name,
  price: formatUsd(price),
}))
const heroImage = await getImage({
  src: angelPortrait,
  layout: 'full-width',
  fit: 'cover',
  position: 'center',
  widths: [480, 720, 1080],
  sizes: '(min-width: 1024px) 50vw, 100vw',
  quality: 82,
})
const control = `${inputClassName} min-h-11 w-full min-w-0`
const proof = [
  {
    image: angelPortrait,
    width: angelPortrait.width,
    height: angelPortrait.height,
    alt: 'Angel celebrating his birthday with family around the cake',
    event: 'Angel’s birthday party',
    href: eventPortraitProofGalleryUrl,
    label: 'See the gallery',
  },
  {
    image: suitPortrait,
    width: suitPortrait.width,
    height: suitPortrait.height,
    alt: 'Professional event portrait of a smiling man wearing a navy suit',
    event: 'Event portrait',
    href: '/portfolio/portraits/',
    label: 'Portrait portfolio',
  },
  {
    image: mccImage.src,
    width: mccImage.width,
    height: mccImage.height,
    alt: mcc.data.imageAlt,
    event: 'Muslim Chamber of Commerce USA workshop',
    href: '/portfolio/muslim-business-chamber-2026/',
    label: 'Attendee portraits',
  },
]
const eventFieldRows = [
  ['date', 'guests'],
  ['venue', 'city'],
  ['eventType'],
] as const
const contactFieldNames = ['name', 'phone', 'email'] as const
const requirement = (name: InquiryFieldName) =>
  (inquiryFieldDefs[name] as InquiryFieldDef).required ? 'Required' : 'Optional'
---

<BaseLayout
  activeNav="event-photography"
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  twitterHandle={siteConfig.site.twitterHandle}
  structuredData={offerStructuredData(eventPortraitOffer, canonicalUrl)}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={heroImage.src}
    imagesrcset={heroImage.srcSet.attribute}
    imagesizes={heroImage.attributes.sizes}
    fetchpriority="high"
  />
  <PageContainer width="wide">
    <section
      aria-labelledby="experience-title"
      class="grid items-center gap-10 py-10 sm:py-16 lg:grid-cols-2 lg:gap-16 lg:py-20"
    >
      <div class="min-w-0">
        <p class="eyebrow mb-5">
          Ayoub Abedrabbo / Event photography / Tampa, FL
        </p>
        <h1 id="experience-title" class="display-hero">
          Good company.
          <br />
          Great memories.
          <br />
          <em>Already in the gallery.</em>
        </h1>
        <p class="text-muted-foreground mt-5 max-w-lg text-lg leading-8">
          Enjoy your event. I’ll photograph the people who make it yours—with
          portraits included and a gallery that updates within minutes.
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-5">
          <a
            href="#inquiry"
            class={buttonVariants({
              size: 'lg',
              className:
                'h-auto min-h-11 max-w-full px-5 py-3 whitespace-normal',
            })}
          >
            Let’s plan your event<span aria-hidden="true">↗</span>
          </a>
          <a href="#pricing" class="link text-sm font-medium">
            See starting prices
          </a>
        </div>
        <p class="text-muted-foreground mt-5 text-xs">
          From{formatUsd(headlineStartingPrice(eventPortraitOffer))}· You host.
          Your guests get the photos free.
        </p>
      </div>
      <figure class="relative min-w-0 pb-12 md:pb-16">
        <Image
          src={angelPortrait}
          alt="Angel celebrating his birthday with family around the cake"
          layout="full-width"
          widths={[480, 720, 1080]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          loading="eager"
          fetchpriority="high"
          quality={82}
          class="aspect-[4/3] rounded-sm object-cover md:aspect-[1/1.05]"
        />
        <figcaption class="bg-background text-muted-foreground absolute inset-x-5 bottom-0 border px-5 py-4 text-xs shadow-md md:bottom-5">
          <span class="text-foreground mb-0.5 block text-sm">
            A real celebration. A real gallery.
          </span>
          Angel’s birthday ·
          <a href={eventPortraitProofGalleryUrl} class="link font-medium">
            See the gallery
          </a>
        </figcaption>
      </figure>
    </section>

    <Separator />

    <ServiceSection titleId="experience-heading" eyebrow="01 / The experience">
      <Fragment slot="title">
        Be there for the moment.
        <em>I’ll take care of the photos.</em>
      </Fragment>
      <ol class="grid gap-6 md:mt-4 md:grid-cols-3 md:gap-12">
        <li class="border-t pt-5">
          <span class="text-muted-foreground text-xs">01</span>
          <h3 class="mt-2 mb-2.5 text-base font-semibold md:mt-4">
            Make it your event.
          </h3>
          <p class="text-muted-foreground text-sm leading-7">
            Tell me the date, place, and people. We’ll confirm availability and
            the right amount of coverage.
          </p>
        </li>
        <li class="border-t pt-5">
          <span class="text-muted-foreground text-xs">02</span>
          <h3 class="mt-2 mb-2.5 text-base font-semibold md:mt-4">
            Bring everyone together.
          </h3>
          <p class="text-muted-foreground text-sm leading-7">
            Event photography and portrait sessions, without a backdrop, flash,
            or lighting kit.
          </p>
        </li>
        <li class="border-t pt-5">
          <span class="text-muted-foreground text-xs">03</span>
          <h3 class="mt-2 mb-2.5 text-base font-semibold md:mt-4">
            Share while it’s happening.
          </h3>
          <p class="text-muted-foreground text-sm leading-7">
            Photos appear in your event gallery within minutes. Guests can
            browse and download at no charge.
          </p>
        </li>
      </ol>
    </ServiceSection>

    <ServiceSection titleId="proof-title" eyebrow="02 / Through my lens">
      <Fragment slot="title">
        Real people.
        <em>Your kind of event.</em>
      </Fragment>
      <p slot="lead">
        From birthday celebrations to community gatherings. Explore the photos
        before you make a plan.
      </p>
      <ul class="grid items-start gap-8 md:grid-cols-3 md:gap-5">
        {proof.map((item, index) => (
          <li>
            <figure>
              <Image
                src={
                  // Local metadata and remote URLs both work at runtime; the cast only satisfies the props union.
                  item.image as string
                }
                width={item.width}
                height={item.height}
                alt={item.alt}
                layout="full-width"
                widths={[400, 640, 960]}
                sizes="(min-width: 768px) 33vw, 100vw"
                quality={78}
                loading={index < 2 ? 'eager' : 'lazy'}
                class:list={[
                  'rounded-sm object-cover',
                  index === 1
                    ? 'aspect-[4/3] object-[center_30%] md:aspect-[4/5] md:object-center'
                    : 'aspect-[4/3]',
                ]}
              />
              <figcaption class="text-muted-foreground mt-3 text-sm leading-6">
                <span class="text-foreground mb-0.5 block text-sm">
                  {item.event}
                </span>
                <a
                  href={item.href}
                  aria-label={`${item.label}: ${item.event}`}
                  class="link font-medium"
                >
                  {item.label} <span aria-hidden="true">↗</span>
                </a>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </ServiceSection>

    <Separator />

    <ServiceSection
      id="pricing"
      titleId="pricing-title"
      eyebrow="03 / Make room for the memories"
      layout="split"
    >
      <Fragment slot="title">
        Your event.
        <em>Your pace.</em>
      </Fragment>
      <Fragment slot="lead">
        <p>
          Every booking includes event photography, portrait sessions, and your
          live gallery. Choose a starting point below.
        </p>
        <p class="text-foreground text-sm">
          Travel within 30 miles of Tampa included.
        </p>
      </Fragment>
      <div class="w-full max-w-2xl">
        <fieldset
          id="coverage"
          tabindex="-1"
          aria-describedby="error-coverage"
          class="outline-none"
        >
          <legend class="mb-4 px-4 text-sm">
            Choose coverage to fill in your inquiry.
            <span class="text-muted-foreground">
              ({requirement('coverage')})
            </span>
          </legend>
          <div
            class="text-muted-foreground flex justify-between px-4 pb-3 text-xs font-medium"
            aria-hidden="true"
          >
            <span>Coverage</span>
            <span>Starting at</span>
          </div>
          <div class="divide-y border-y">
            {packages.map((option) => (
              <label class="group hover:bg-muted/50 has-checked:bg-muted has-checked:border-primary has-focus-visible:ring-ring flex min-h-11 w-full cursor-pointer flex-wrap items-center justify-between gap-4 border-l-2 border-transparent px-4 py-4 has-focus-visible:ring-2 has-focus-visible:ring-inset">
                <input
                  type="radio"
                  name="coverage"
                  value={option.hours}
                  form="event-portrait-inquiry"
                  class="sr-only"
                />
                <span class="min-w-0 flex-[1_1_10rem]">
                  <span class="block font-semibold">{option.hours}</span>
                  <span class="text-muted-foreground mt-1 block text-sm">
                    Planning pace: about 20 portrait sessions per hour, not a
                    cap
                  </span>
                </span>
                <span class="flex max-w-full shrink-0 flex-wrap items-center gap-2.5 text-2xl font-bold tabular-nums">
                  <small class="text-muted-foreground text-[0.65rem] font-normal">
                    from
                  </small>{' '}
                  {option.price}
                  <span
                    class="border-muted-foreground group-has-checked:bg-primary group-has-checked:border-primary group-has-checked:text-primary-foreground inline-grid size-6 place-items-center rounded-full border"
                    aria-hidden="true"
                  >
                    <Check
                      size={16}
                      className="invisible group-has-checked:visible"
                    />
                  </span>
                </span>
              </label>
            ))}
          </div>
          <p
            id="error-coverage"
            class="text-foreground mt-3 px-4 text-sm"
            hidden
          ></p>
        </fieldset>
        <p class="text-muted-foreground mt-4 px-4 text-sm leading-6">
          Need more time? Add an extra hour for{' '}
          <span class="text-foreground font-medium tabular-nums">
            +{formatUsd(eventPortraitExtraHour.price)}
          </span>
          .
        </p>
        <div class="mt-4 grid gap-1 px-4 text-sm leading-6">
          <p>
            <a href="#inquiry" class="link font-medium">
              Continue to event details ↗
            </a>
          </p>
          <p class="text-muted-foreground">
            No backdrop, flash, or lighting kit.
          </p>
        </div>
      </div>
    </ServiceSection>

    <Separator />

    <ServiceSection
      id="inquiry"
      titleId="inquiry-title"
      eyebrow="04 / Let’s make it happen"
      layout="split"
      stickyIntro
    >
      <Fragment slot="title">
        Tell me what you’re
        <em>celebrating.</em>
      </Fragment>
      <Fragment slot="lead">
        <p>Opens an email draft to Ayoub. It does not reserve the date.</p>
        <p>
          I’ll review the details with you and confirm availability. For
          coverage up to 8 hours or extras, include what you have in mind.
        </p>
      </Fragment>
      <div class="bg-muted rounded-md border p-5 md:p-8">
        <form id="event-portrait-inquiry" class="grid gap-6" novalidate>
          <div
            id="inquiry-errors"
            class="border-destructive bg-destructive/10 text-foreground hidden rounded-xl border px-4 py-3 text-sm"
            tabindex="-1"
            role="alert"
          ></div>
          <fieldset class="min-w-0">
            <legend class="mb-4 text-sm font-semibold">The event</legend>
            <FieldGroup>
              <Field className="min-w-0">
                <FieldLabel
                  htmlFor="extraTime"
                  className="max-w-full flex-wrap justify-between"
                >
                  {inquiryFieldDefs.extraTime.label}
                  <span class="text-muted-foreground text-xs font-normal">
                    {requirement('extraTime')}
                  </span>
                </FieldLabel>
                <input
                  id="extraTime"
                  name="extraTime"
                  class={control}
                  placeholder={inquiryFieldDefs.extraTime.placeholder}
                />
              </Field>
              {eventFieldRows.map((row) => (
                <div
                  class:list={[
                    'grid gap-4',
                    row.length > 1 && 'sm:grid-cols-2',
                  ]}
                >
                  {row.map((id) => {
                    const field: InquiryFieldDef = inquiryFieldDefs[id]
                    return (
                      <Field className="min-w-0">
                        <FieldLabel
                          htmlFor={id}
                          className="max-w-full flex-wrap justify-between"
                        >
                          {field.label}
                          <span class="text-muted-foreground text-xs font-normal">
                            {requirement(id)}
                          </span>
                        </FieldLabel>
                        <input
                          id={id}
                          name={id}
                          type={field.type ?? 'text'}
                          autocomplete={field.autocomplete}
                          placeholder={field.placeholder}
                          {...(field.type === 'number'
                            ? { min: '1', step: '1', inputmode: 'numeric' }
                            : {})}
                          required
                          aria-describedby={`error-${id}`}
                          class={control}
                        />
                        <p
                          id={`error-${id}`}
                          class="text-foreground text-sm"
                          hidden
                        ></p>
                      </Field>
                    )
                  })}
                </div>
              ))}
            </FieldGroup>
          </fieldset>
          <fieldset class="min-w-0">
            <legend class="mb-4 text-sm font-semibold">How to reach you</legend>
            <FieldGroup className="grid gap-4 sm:grid-cols-2">
              {contactFieldNames.map((id) => {
                const field: InquiryFieldDef = inquiryFieldDefs[id]
                return (
                  <Field className="min-w-0">
                    <FieldLabel
                      htmlFor={id}
                      className="max-w-full flex-wrap justify-between"
                    >
                      {field.label}
                      <span class="text-muted-foreground text-xs font-normal">
                        {requirement(id)}
                      </span>
                    </FieldLabel>
                    <input
                      id={id}
                      name={id}
                      type={field.type ?? 'text'}
                      autocomplete={field.autocomplete}
                      enterkeyhint={id === 'email' ? 'done' : undefined}
                      required
                      aria-describedby={`error-${id}`}
                      class={control}
                    />
                    <p
                      id={`error-${id}`}
                      class="text-foreground text-sm"
                      hidden
                    ></p>
                  </Field>
                )
              })}
            </FieldGroup>
          </fieldset>
          <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
            <p
              id="inquiry-selection"
              class="text-sm font-medium"
              aria-live="polite"
              hidden
            ></p>
            <button
              type="submit"
              class={buttonVariants({
                size: 'lg',
                className:
                  'h-auto min-h-11 max-w-full px-5 py-3 whitespace-normal',
              })}
            >
              Open email draft
            </button>
            <a href="/contact/" class="link text-sm font-medium">
              Or use the contact page
            </a>
          </div>
        </form>
        <div
          id="inquiry-ready"
          class="bg-muted/50 mt-6 hidden rounded-2xl p-6"
          role="status"
        >
          <h3 class="text-lg font-semibold">
            Request ready for Ayoub to review.
          </h3>
          <p
            id="inquiry-ready-copy"
            class="text-muted-foreground mt-2 text-sm leading-6"
          ></p>
          <p class="mt-3 text-sm leading-6">
            This does not reserve the date, and this page does not send the
            email itself.
          </p>
          <a
            id="inquiry-mailto"
            class="link mt-4 inline-flex min-h-11 items-center text-sm font-medium"
            href=""
          >
            Open the email draft again
          </a>
        </div>
      </div>
    </ServiceSection>

    <Separator />

    <section aria-label="Contact" class="py-8 text-sm leading-7">
      <p class="flex flex-wrap gap-x-2">
        <span>Ayoub Abedrabbo · Alpha Bravo Media</span>
        <span aria-hidden="true">·</span>
        <a href={`mailto:${inquiryEmail}`} class="link font-medium">
          {inquiryEmail}
        </a>
        <span aria-hidden="true">·</span>
        <span>Tampa, Florida</span>
        <span aria-hidden="true">·</span>
        <a href={mapsListingUrl} class="link font-medium">
          Find us on Google Maps
        </a>
      </p>
    </section>
    <script>
      import {
        inquiryErrors,
        inquiryFieldNames,
        inquiryMailto,
        startingPriceFor,
        type InquiryFields,
      } from '../../lib/event-portrait-inquiry'
      import { formatUsd } from '../../lib/service-offer'

      const form = document.querySelector('#event-portrait-inquiry')
      const errors = document.querySelector('#inquiry-errors')
      const ready = document.querySelector('#inquiry-ready')
      const readyCopy = document.querySelector('#inquiry-ready-copy')
      const mailtoLink = document.querySelector('#inquiry-mailto')
      const coverage = document.querySelector('#coverage')
      const selection = document.querySelector('#inquiry-selection')
      const fieldNames = inquiryFieldNames
      const clearFieldErrors = () => {
        for (const name of fieldNames) {
          document.getElementById(name)?.removeAttribute('aria-invalid')
          const message = document.getElementById(`error-${name}`)
          if (message) {
            message.hidden = true
            message.textContent = ''
          }
        }
      }
      const showFieldErrors = (
        problems: Partial<Record<(typeof fieldNames)[number], string>>,
      ) => {
        clearFieldErrors()
        let first: HTMLElement | null = null
        for (const name of fieldNames) {
          const message = problems[name]
          if (!message) continue
          const field = document.getElementById(name)
          const slot = document.getElementById(`error-${name}`)
          field?.setAttribute('aria-invalid', 'true')
          if (slot) {
            slot.hidden = false
            slot.textContent = message
          }
          if (!first && field) first = field
        }
        first?.focus()
      }
      const showSelection = () => {
        if (!(selection instanceof HTMLElement)) return
        const checked = document.querySelector<HTMLInputElement>(
          'input[name="coverage"]:checked',
        )
        const price = checked && startingPriceFor(checked.value)
        selection.hidden = !checked
        selection.textContent =
          checked && price != null
            ? `${checked.value}, starting at ${formatUsd(price)}`
            : ''
      }
      coverage?.addEventListener('change', showSelection)
      form?.addEventListener('submit', (event) => {
        event.preventDefault()
        if (
          !(form instanceof HTMLFormElement) ||
          !(errors instanceof HTMLElement) ||
          !(ready instanceof HTMLElement) ||
          !(readyCopy instanceof HTMLElement) ||
          !(mailtoLink instanceof HTMLAnchorElement)
        ) {
          return
        }
        const data = new FormData(form)
        const fields = Object.fromEntries(
          fieldNames.map((name) => [name, String(data.get(name) ?? '')]),
        ) as InquiryFields
        const problems = inquiryErrors(fields)
        const messages = Object.values(problems)
        if (messages.length > 0) {
          errors.classList.remove('hidden')
          errors.textContent =
            messages.length === 1
              ? messages[0]
              : `Check ${messages.length} fields.`
          ready.classList.add('hidden')
          showFieldErrors(problems)
          return
        }
        const href = inquiryMailto(fields)
        const price = startingPriceFor(fields.coverage)
        clearFieldErrors()
        errors.classList.add('hidden')
        ready.classList.remove('hidden')
        readyCopy.textContent = `${fields.coverage}, starting at ${formatUsd(price ?? 0)}.`
        mailtoLink.href = href
        mailtoLink.click()
      })
    </script>
  </PageContainer>
</BaseLayout>
