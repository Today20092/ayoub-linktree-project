---
import '../../styles.css'
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import { buttonVariants } from '@/components/ui/button'
import { Separator } from '@/components/ui/separator'
import BaseLayout from '../../layouts/BaseLayout.astro'
import {
  eventPortraitDescription,
  eventPortraitEmail,
  eventPortraitPackages,
  eventPortraitPhone,
  eventPortraitStructuredData,
  eventPortraitTitle,
} from '../../lib/event-portrait-offer'
import { siteConfig } from '../../lib/site-config'

const portraitAssets = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/portraits/P1210300.JPG',
  { eager: true },
)
const eventPortrait =
  portraitAssets['../../assets/portraits/P1210300.JPG'].default

const title = eventPortraitTitle
const description = eventPortraitDescription
const canonicalUrl = new URL(
  '/services/event-portraits/',
  Astro.site,
).toString()
const ogImage = new URL(siteConfig.site.ogImage, Astro.site).toString()
const packages = eventPortraitPackages
---

<BaseLayout
  activeNav="portraits"
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  ogImage={ogImage}
  ogImageWidth={siteConfig.site.ogImageWidth}
  ogImageHeight={siteConfig.site.ogImageHeight}
  ogImageType={siteConfig.site.ogImageType}
  ogImageAlt={siteConfig.site.ogImageAlt}
  twitterHandle={siteConfig.site.twitterHandle}
  structuredData={eventPortraitStructuredData(canonicalUrl)}
>
  <main id="main-content" class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
    <section
      aria-labelledby="experience-title"
      class="grid items-center gap-8 py-10 sm:py-14 lg:grid-cols-2 lg:gap-12 lg:py-20"
    >
      <div>
        <h1
          id="experience-title"
          class="text-4xl leading-[1.08] font-extrabold tracking-tight text-balance sm:text-5xl"
        >
          Your event. A gallery within minutes.
        </h1>
        <p class="text-muted-foreground mt-6 max-w-lg text-lg leading-8">
          Book Ayoub for the event in Tampa. You get the photographs and a
          gallery that updates within minutes. Portrait sessions are a main part
          of the booking. The host pays. Guests receive photos at no charge.
        </p>
        <div class="mt-7 flex flex-wrap items-center gap-5">
          <a
            href="#inquiry"
            class={`${buttonVariants({ size: 'lg' })} min-h-11 px-5`}
          >
            Request a quote
          </a>
          <a
            href="#pricing"
            class="text-primary rounded-sm text-sm font-medium underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4"
          >
            View pricing
          </a>
        </div>
      </div>
      <figure>
        <Image
          src={eventPortrait}
          alt="Two guests smiling together for a professional portrait at an event"
          layout="full-width"
          widths={[480, 720, 1080]}
          sizes="(min-width: 1024px) 520px, (min-width: 640px) 90vw, 100vw"
          loading="eager"
          fetchpriority="high"
          quality={82}
          class="aspect-[4/3] rounded-2xl object-cover"
        />
        <figcaption class="text-muted-foreground mt-3 text-sm">
          Event portraits by Ayoub Abedrabbo
        </figcaption>
      </figure>
    </section>

    <Separator />

    <section aria-labelledby="guest-experience-title" class="py-10 sm:py-14">
      <div class="max-w-2xl">
        <h2
          id="guest-experience-title"
          class="text-2xl font-bold tracking-tight sm:text-3xl"
        >
          What you get
        </h2>
        <p class="mt-4 text-sm leading-6">
          <a
            href="/portfolio/portraits/"
            class="text-primary rounded-sm font-medium underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4"
          >
            Portrait portfolio
          </a>
          <span class="text-muted-foreground">·</span>
          <a
            href="/portfolio/muslim-business-chamber-2026/"
            class="text-primary rounded-sm font-medium underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4"
          >
            Attendee portraits at a Tampa event
          </a>
        </p>
        <p class="text-muted-foreground mt-3 text-sm leading-6">
          <a
            class="text-foreground underline underline-offset-4"
            href={`mailto:${eventPortraitEmail}`}
          >
            {eventPortraitEmail}
          </a>
          <span>·</span>
          <a
            class="text-foreground underline underline-offset-4"
            href="tel:+18134240606"
          >
            {eventPortraitPhone}
          </a>
        </p>
      </div>
      <ol class="mt-8 grid gap-6 sm:grid-cols-3">
        <li>
          <h3 class="font-semibold">Event photography</h3>
          <p class="text-muted-foreground mt-2 text-sm leading-6">
            Coverage of the gathering, not only a portrait booth.
          </p>
        </li>
        <li>
          <h3 class="font-semibold">Portrait sessions</h3>
          <p class="text-muted-foreground mt-2 text-sm leading-6">
            A main part of the booking. About 20 an hour, as a planning
            estimate.
          </p>
        </li>
        <li>
          <h3 class="font-semibold">The event gallery</h3>
          <p class="text-muted-foreground mt-2 text-sm leading-6">
            Each photo shows up within minutes of being taken.
          </p>
        </li>
      </ol>
    </section>

    <Separator />

    <section
      id="pricing"
      aria-labelledby="pricing-title"
      class="scroll-mt-24 py-10 sm:py-14"
    >
      <h2
        id="pricing-title"
        class="text-2xl font-bold tracking-tight sm:text-3xl"
      >
        Starting prices
      </h2>
      <p class="text-muted-foreground mt-4 max-w-2xl leading-7">
        Ayoub, camera, and lighting. Prices are starting points.
      </p>
      <div class="mt-8 max-w-3xl">
        <table class="w-full text-left">
          <caption class="sr-only">
            Starting prices in US dollars and approximate portrait sessions by
            coverage time
          </caption>
          <thead class="text-muted-foreground text-xs">
            <tr>
              <th scope="col" class="pb-4 font-medium">
                Coverage
              </th>
              <th scope="col" class="pb-4 font-medium">
                Portrait sessions
              </th>
              <th scope="col" class="pb-4 text-right font-medium">
                Starting at
              </th>
            </tr>
          </thead>
          <tbody>
            {packages.map((option) => (
              <tr class="odd:bg-muted/50">
                <th
                  scope="row"
                  class="rounded-l-lg px-3 py-5 text-sm font-semibold sm:text-base"
                >
                  {option.hours}
                </th>
                <td class="text-muted-foreground px-2 py-5 text-sm">
                  {option.sessions}
                </td>
                <td class="rounded-r-lg px-3 py-5 text-right text-xl font-bold tracking-tight tabular-nums sm:text-2xl">
                  {option.price}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="text-muted-foreground mt-4 text-sm leading-6">
          Extra hour +$150. Travel is included within 30 miles of Tampa. Farther
          travel, a helper, a backdrop, a same-night highlight, and a rush
          gallery are quoted separately. Up to 8 hours is a custom quote.
        </p>
      </div>
    </section>

    <Separator />

    <section
      id="inquiry"
      aria-labelledby="inquiry-title"
      class="scroll-mt-24 py-10 sm:py-14"
    >
      <div class="max-w-2xl">
        <h2
          id="inquiry-title"
          class="text-2xl font-bold tracking-tight sm:text-3xl"
        >
          Request a quote
        </h2>
        <p class="text-muted-foreground mt-4 leading-7">
          Opens an email draft to Ayoub. Required fields are marked. This does
          not reserve the date.
        </p>
      </div>
      <form
        id="event-portrait-inquiry"
        class="mt-8 grid max-w-2xl gap-5"
        novalidate
      >
        <div
          id="inquiry-errors"
          class="border-destructive bg-destructive/10 text-destructive hidden rounded-xl border px-4 py-3 text-sm"
          tabindex="-1"
          role="alert"
        ></div>
        <div class="grid gap-5 sm:grid-cols-2">
          <label class="grid gap-2 text-sm font-medium" for="coverage">
            <span class="flex items-baseline justify-between gap-3">
              Coverage
              <span class="text-muted-foreground text-xs font-normal">
                Required
              </span>
            </span>
            <select
              id="coverage"
              name="coverage"
              required
              class="border-input bg-background min-h-11 rounded-xl border px-3"
            >
              <option value="">Choose coverage</option>
              {packages.map((option) => (
                <option value={option.hours}>
                  {option.hours}, starting at {option.price}
                </option>
              ))}
            </select>
          </label>
          <label class="grid gap-2 text-sm font-medium" for="extraTime">
            <span class="flex items-baseline justify-between gap-3">
              Longer coverage
              <span class="text-muted-foreground text-xs font-normal">
                Optional
              </span>
            </span>
            <input
              id="extraTime"
              name="extraTime"
              class="border-input bg-background min-h-11 rounded-xl border px-3"
              placeholder="Up to 8 hours"
            />
          </label>
        </div>
        <div class="grid gap-5 sm:grid-cols-2">
          <label class="grid gap-2 text-sm font-medium" for="date">
            <span class="flex items-baseline justify-between gap-3">
              Date
              <span class="text-muted-foreground text-xs font-normal">
                Required
              </span>
            </span>
            <input
              id="date"
              name="date"
              type="date"
              required
              class="border-input bg-background min-h-11 rounded-xl border px-3"
            />
          </label>
          <label class="grid gap-2 text-sm font-medium" for="guests">
            <span class="flex items-baseline justify-between gap-3">
              Guests
              <span class="text-muted-foreground text-xs font-normal">
                Required
              </span>
            </span>
            <input
              id="guests"
              name="guests"
              type="number"
              min="0"
              step="1"
              inputmode="numeric"
              required
              class="border-input bg-background min-h-11 rounded-xl border px-3"
            />
          </label>
        </div>
        <div class="grid gap-5 sm:grid-cols-2">
          <label class="grid gap-2 text-sm font-medium" for="venue">
            <span class="flex items-baseline justify-between gap-3">
              Venue
              <span class="text-muted-foreground text-xs font-normal">
                Required
              </span>
            </span>
            <input
              id="venue"
              name="venue"
              required
              class="border-input bg-background min-h-11 rounded-xl border px-3"
            />
          </label>
          <label class="grid gap-2 text-sm font-medium" for="city">
            <span class="flex items-baseline justify-between gap-3">
              City
              <span class="text-muted-foreground text-xs font-normal">
                Required
              </span>
            </span>
            <input
              id="city"
              name="city"
              autocomplete="address-level2"
              required
              class="border-input bg-background min-h-11 rounded-xl border px-3"
            />
          </label>
        </div>
        <label class="grid gap-2 text-sm font-medium" for="eventType">
          <span class="flex items-baseline justify-between gap-3">
            Event type
            <span class="text-muted-foreground text-xs font-normal">
              Required
            </span>
          </span>
          <input
            id="eventType"
            name="eventType"
            required
            class="border-input bg-background min-h-11 rounded-xl border px-3"
            placeholder="Mosque, school, nonprofit, or community event"
          />
        </label>
        <div class="grid gap-5 sm:grid-cols-3">
          <label class="grid gap-2 text-sm font-medium" for="name">
            <span class="flex items-baseline justify-between gap-3">
              Name
              <span class="text-muted-foreground text-xs font-normal">
                Required
              </span>
            </span>
            <input
              id="name"
              name="name"
              autocomplete="name"
              required
              class="border-input bg-background min-h-11 rounded-xl border px-3"
            />
          </label>
          <label class="grid gap-2 text-sm font-medium" for="phone">
            <span class="flex items-baseline justify-between gap-3">
              Phone
              <span class="text-muted-foreground text-xs font-normal">
                Required
              </span>
            </span>
            <input
              id="phone"
              name="phone"
              type="tel"
              autocomplete="tel"
              required
              class="border-input bg-background min-h-11 rounded-xl border px-3"
            />
          </label>
          <label class="grid gap-2 text-sm font-medium" for="email">
            <span class="flex items-baseline justify-between gap-3">
              Email
              <span class="text-muted-foreground text-xs font-normal">
                Required
              </span>
            </span>
            <input
              id="email"
              name="email"
              type="email"
              enterkeyhint="done"
              autocomplete="email"
              required
              class="border-input bg-background min-h-11 rounded-xl border px-3"
            />
          </label>
        </div>
        <div class="flex flex-wrap items-center gap-5">
          <button
            type="submit"
            class={buttonVariants({ size: 'lg', className: 'min-h-11 px-5' })}
          >
            Open email draft
          </button>
          <a
            href="/contact/"
            class="text-primary rounded-sm text-sm font-medium underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4"
          >
            Or use the contact page
          </a>
        </div>
      </form>
      <div
        id="inquiry-ready"
        class="mt-6 hidden max-w-2xl rounded-2xl bg-muted/50 p-6"
        role="status"
      >
        <h3 class="text-lg font-semibold">
          Request ready for Ayoub to review.
        </h3>
        <p
          id="inquiry-ready-copy"
          class="text-muted-foreground mt-2 text-sm leading-6"
        ></p>
        <p class="mt-3 text-sm leading-6">
          This does not reserve the date, and this page does not send the email
          itself.
        </p>
        <a
          id="inquiry-mailto"
          class="text-primary mt-4 inline-flex min-h-11 items-center text-sm font-medium underline underline-offset-4"
          href=""
        >
          Open the email draft again
        </a>
      </div>
    </section>
    <script>
      import {
        inquiryErrors,
        inquiryMailto,
      } from '../../lib/event-portrait-inquiry'

      const form = document.querySelector('#event-portrait-inquiry')
      const errors = document.querySelector('#inquiry-errors')
      const ready = document.querySelector('#inquiry-ready')
      const readyCopy = document.querySelector('#inquiry-ready-copy')
      const mailtoLink = document.querySelector('#inquiry-mailto')
      form?.addEventListener('submit', (event) => {
        event.preventDefault()
        if (
          !(form instanceof HTMLFormElement) ||
          !(errors instanceof HTMLElement) ||
          !(ready instanceof HTMLElement) ||
          !(readyCopy instanceof HTMLElement) ||
          !(mailtoLink instanceof HTMLAnchorElement)
        ) {
          return
        }
        const data = new FormData(form)
        const fields = {
          coverage: String(data.get('coverage') ?? ''),
          extraTime: String(data.get('extraTime') ?? ''),
          date: String(data.get('date') ?? ''),
          venue: String(data.get('venue') ?? ''),
          city: String(data.get('city') ?? ''),
          guests: String(data.get('guests') ?? ''),
          eventType: String(data.get('eventType') ?? ''),
          name: String(data.get('name') ?? ''),
          phone: String(data.get('phone') ?? ''),
          email: String(data.get('email') ?? ''),
        }
        const packages = [...form.querySelectorAll('option')]
          .filter((option) => option.value !== '')
          .map((option) => {
            const price = option.textContent?.split('starting at ')[1]?.trim()
            return { hours: option.value, price: price ?? '' }
          })
        const problems = inquiryErrors(fields, packages)
        const first = Object.values(problems)[0]
        if (first) {
          errors.classList.remove('hidden')
          errors.textContent = first
          errors.focus()
          ready.classList.add('hidden')
          return
        }
        const href = inquiryMailto(fields, packages)
        const selected = packages.find(
          (option) => option.hours === fields.coverage,
        )
        errors.classList.add('hidden')
        ready.classList.remove('hidden')
        readyCopy.textContent = `${fields.coverage}, starting at ${selected?.price}.`
        mailtoLink.href = href
        window.location.href = href
      })
    </script>
  </main>
</BaseLayout>
