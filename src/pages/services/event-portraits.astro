---
import '../../styles.css'
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import { buttonVariants } from '@/components/ui/button'
import { Separator } from '@/components/ui/separator'
import BaseLayout from '../../layouts/BaseLayout.astro'
import {
  eventPortraitAnswers,
  eventPortraitDescription,
  eventPortraitEmail,
  eventPortraitPackages,
  eventPortraitPhone,
  eventPortraitStructuredData,
  eventPortraitTitle,
} from '../../lib/event-portrait-offer'
import { siteConfig } from '../../lib/site-config'

const portraitAssets = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/portraits/P1210300.JPG',
  { eager: true },
)
const eventPortrait =
  portraitAssets['../../assets/portraits/P1210300.JPG'].default

const title = eventPortraitTitle
const description = eventPortraitDescription
const canonicalUrl = new URL(
  '/services/event-portraits/',
  Astro.site,
).toString()
const ogImage = new URL(siteConfig.site.ogImage, Astro.site).toString()
const packages = eventPortraitPackages
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  ogImage={ogImage}
  ogImageAlt={siteConfig.site.ogImageAlt}
  twitterHandle={siteConfig.site.twitterHandle}
  structuredData={eventPortraitStructuredData(canonicalUrl)}
>
  <main id="main-content" class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
    <section
      aria-labelledby="experience-title"
      class="grid items-center gap-8 py-10 sm:py-14 lg:grid-cols-2 lg:gap-12 lg:py-20"
    >
      <div>
        <p class="text-primary text-sm font-semibold">
          Instant event photography · Tampa, Florida
        </p>
        <h1
          id="experience-title"
          class="mt-5 text-4xl leading-[1.08] font-extrabold tracking-tight text-balance sm:text-5xl"
        >
          A gift your guests can take home.
        </h1>
        <p class="text-muted-foreground mt-6 max-w-lg text-lg leading-8">
          Ayoub Abedrabbo makes instant guest portraits at events in Tampa,
          Florida. Professional photos, on their phones in minutes. An
          experience they can enjoy, keep, and share before the event ends.
        </p>
        <div class="mt-7 flex flex-wrap items-center gap-5">
          <a
            href="#inquiry"
            class={`${buttonVariants({ size: 'lg' })} min-h-11 px-5`}
          >
            Request a quote
          </a>
          <a
            href="#pricing"
            class="text-primary rounded-sm text-sm font-medium underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4"
          >
            View pricing
          </a>
        </div>
      </div>
      <figure>
        <Image
          src={eventPortrait}
          alt="Two guests smiling together for a professional portrait at an event"
          layout="full-width"
          widths={[480, 720, 1080]}
          sizes="(min-width: 1024px) 520px, (min-width: 640px) 90vw, 100vw"
          loading="eager"
          fetchpriority="high"
          quality={82}
          class="aspect-[4/3] rounded-2xl object-cover"
        />
        <figcaption class="text-muted-foreground mt-3 text-sm">
          Event portraits by Ayoub Abedrabbo
        </figcaption>
      </figure>
    </section>

    <Separator />

    <section aria-labelledby="guest-experience-title" class="py-10 sm:py-14">
      <div class="max-w-2xl">
        <h2
          id="guest-experience-title"
          class="text-2xl font-bold tracking-tight sm:text-3xl"
        >
          They're already dressed for the occasion.
        </h2>
        <p class="text-muted-foreground mt-4 text-base leading-7">
          Give them a reason to remember it. A fresh LinkedIn headshot, a photo
          with their family, or a portrait with a friend. You host the
          experience for your mosque, school, nonprofit, or community event; the
          organizer pays and guests receive their photos at no charge.
        </p>
        <p class="mt-4 text-sm leading-6">
          <a
            href="/portfolio/portraits/"
            class="text-primary rounded-sm font-medium underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4"
          >
            Portrait portfolio
          </a>
          <span class="text-muted-foreground">·</span>
          <a
            href="/portfolio/muslim-business-chamber-2026/"
            class="text-primary rounded-sm font-medium underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4"
          >
            Attendee portraits at a Tampa event
          </a>
        </p>
        <p class="text-muted-foreground mt-3 text-sm leading-6">
          <a
            class="text-foreground underline underline-offset-4"
            href={`mailto:${eventPortraitEmail}`}
          >
            {eventPortraitEmail}
          </a>
          <span>·</span>
          <a
            class="text-foreground underline underline-offset-4"
            href="tel:+18134240606"
          >
            {eventPortraitPhone}
          </a>
        </p>
      </div>
      <ol class="mt-8 grid gap-7 sm:grid-cols-3 sm:gap-8">
        <li>
          <h3 class="font-semibold">A quick portrait</h3>
          <p class="text-muted-foreground mt-2 text-sm leading-6">
            I bring a professional camera and lighting, and help guests feel
            comfortable in front of the camera. Individuals, couples, families,
            and small groups are welcome.
          </p>
        </li>
        <li>
          <h3 class="font-semibold">Photos on their phone</h3>
          <p class="text-muted-foreground mt-2 text-sm leading-6">
            Guests can receive their photos directly on iPhone or Android,
            typically within a few minutes, using Quick Share or a compatible
            phone transfer.
          </p>
        </li>
        <li>
          <h3 class="font-semibold">Ready to use and share</h3>
          <p class="text-muted-foreground mt-2 text-sm leading-6">
            High-quality photos ready for a profile, a post, or a family album.
            A shareable gallery updates during the event, usually within an
            hour, depending on connectivity.
          </p>
        </li>
      </ol>
    </section>

    <Separator />

    <section
      id="pricing"
      aria-labelledby="pricing-title"
      class="scroll-mt-24 py-10 sm:py-14"
    >
      <h2
        id="pricing-title"
        class="text-2xl font-bold tracking-tight sm:text-3xl"
      >
        One booking. An experience for your guests.
      </h2>
      <p class="text-muted-foreground mt-4 max-w-2xl leading-7">
        Choose the time that fits your event. Every booking includes the
        photographer (Ayoub alone), professional camera and lighting, photo
        delivery to guests' phones during the event, and a shareable gallery.
      </p>
      <div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)] lg:gap-12">
        <div>
          <table class="w-full text-left">
            <caption class="sr-only">
              Starting prices in US dollars and approximate portrait sessions by
              coverage time
            </caption>
            <thead class="text-muted-foreground text-xs">
              <tr>
                <th scope="col" class="pb-4 font-medium">
                  Coverage
                </th>
                <th scope="col" class="pb-4 font-medium">
                  Portrait sessions
                </th>
                <th scope="col" class="pb-4 text-right font-medium">
                  Starting at
                </th>
              </tr>
            </thead>
            <tbody>
              {packages.map((option) => (
                <tr class="odd:bg-muted/50">
                  <th
                    scope="row"
                    class="rounded-l-lg px-3 py-5 text-sm font-semibold sm:text-base"
                  >
                    {option.hours}
                  </th>
                  <td class="text-muted-foreground px-2 py-5 text-sm">
                    {option.sessions}
                  </td>
                  <td class="rounded-r-lg px-3 py-5 text-right text-xl font-bold tracking-tight tabular-nums sm:text-2xl">
                    {option.price}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="text-muted-foreground mt-4 text-sm leading-6">
            Each extra hour starts at +$150. All prices in USD. Allow
            approximately 20 portrait sessions per hour, depending on group size
            and event flow. A session may include one person, a couple, or a
            small group. This is a planning estimate, not a guarantee that every
            attendee will be photographed.
          </p>
        </div>
        <div class="bg-muted/50 rounded-2xl p-6 sm:p-8">
          <h3 class="text-lg font-semibold">Plan around your event</h3>
          <dl class="mt-5 flex flex-col gap-5 text-sm leading-6">
            <div>
              <dt class="font-semibold">Travel included</dt>
              <dd class="text-muted-foreground">
                Within 30 miles of Tampa, Florida. Travel beyond that is quoted
                separately.
              </dd>
            </div>
            <div>
              <dt class="font-semibold">Larger or busier events</dt>
              <dd class="text-muted-foreground">
                Coverage up to 8 hours, large attendance, and high portrait
                demand require a custom quote.
              </dd>
            </div>
            <div>
              <dt class="font-semibold">Portraits come first</dt>
              <dd class="text-muted-foreground">
                I can capture event moments between portraits when time allows.
                Dedicated candid coverage requires a custom quote.
              </dd>
            </div>
            <div>
              <dt class="font-semibold">Quoted add-ons</dt>
              <dd class="text-muted-foreground">
                A helper or second shooter, branded backdrop, same-night
                organizer highlight clip, travel beyond 30 miles, and rush
                gallery are available by custom quote.
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <Separator />

    <section aria-labelledby="portrait-answers-title" class="py-10 sm:py-14">
      <h2
        id="portrait-answers-title"
        class="text-2xl font-bold tracking-tight sm:text-3xl"
      >
        Questions hosts ask
      </h2>
      <dl class="mt-8 grid max-w-3xl gap-6">
        {eventPortraitAnswers.map((item) => (
          <div>
            <dt class="font-semibold">{item.question}</dt>
            <dd class="text-muted-foreground mt-2 leading-7">{item.answer}</dd>
          </div>
        ))}
      </dl>
    </section>

    <Separator />

    <section
      id="inquiry"
      aria-labelledby="inquiry-title"
      class="scroll-mt-24 py-10 sm:py-14"
    >
      <div class="max-w-2xl">
        <h2
          id="inquiry-title"
          class="text-2xl font-bold tracking-tight sm:text-3xl"
        >
          Request a quote
        </h2>
        <p class="text-muted-foreground mt-4 leading-7">
          Send the date, venue, guest count, and coverage. Ayoub reviews the
          request and confirms the quote. Submitting opens your email app. It
          does not reserve the date.
        </p>
      </div>
      <form
        id="event-portrait-inquiry"
        class="mt-8 grid max-w-2xl gap-5"
        novalidate
      >
        <div
          id="inquiry-errors"
          class="border-destructive bg-destructive/10 text-destructive hidden rounded-xl border px-4 py-3 text-sm"
          tabindex="-1"
          role="alert"
        ></div>
        <div class="grid gap-5 sm:grid-cols-2">
          <label class="grid gap-2 text-sm font-medium" for="coverage">
            Coverage
            <select
              id="coverage"
              name="coverage"
              required
              class="border-input bg-background min-h-11 rounded-xl border px-3"
            >
              <option value="">Choose coverage</option>
              {packages.map((option) => (
                <option value={option.hours}>
                  {option.hours}, starting at {option.price}
                </option>
              ))}
            </select>
          </label>
          <label class="grid gap-2 text-sm font-medium" for="extraTime">
            Longer coverage
            <input
              id="extraTime"
              name="extraTime"
              class="border-input bg-background min-h-11 rounded-xl border px-3"
              placeholder="Optional, up to 8 hours"
            />
          </label>
        </div>
        <div class="grid gap-5 sm:grid-cols-2">
          <label class="grid gap-2 text-sm font-medium" for="date">
            Date
            <input
              id="date"
              name="date"
              type="date"
              required
              class="border-input bg-background min-h-11 rounded-xl border px-3"
            />
          </label>
          <label class="grid gap-2 text-sm font-medium" for="guests">
            Approximate guests
            <input
              id="guests"
              name="guests"
              inputmode="numeric"
              required
              class="border-input bg-background min-h-11 rounded-xl border px-3"
            />
          </label>
        </div>
        <div class="grid gap-5 sm:grid-cols-2">
          <label class="grid gap-2 text-sm font-medium" for="venue">
            Venue
            <input
              id="venue"
              name="venue"
              required
              class="border-input bg-background min-h-11 rounded-xl border px-3"
            />
          </label>
          <label class="grid gap-2 text-sm font-medium" for="city">
            City
            <input
              id="city"
              name="city"
              required
              class="border-input bg-background min-h-11 rounded-xl border px-3"
            />
          </label>
        </div>
        <label class="grid gap-2 text-sm font-medium" for="eventType">
          Event type
          <input
            id="eventType"
            name="eventType"
            required
            class="border-input bg-background min-h-11 rounded-xl border px-3"
            placeholder="Mosque, school, nonprofit, or community event"
          />
        </label>
        <div class="grid gap-5 sm:grid-cols-3">
          <label class="grid gap-2 text-sm font-medium" for="name">
            Name
            <input
              id="name"
              name="name"
              autocomplete="name"
              required
              class="border-input bg-background min-h-11 rounded-xl border px-3"
            />
          </label>
          <label class="grid gap-2 text-sm font-medium" for="phone">
            Phone
            <input
              id="phone"
              name="phone"
              type="tel"
              autocomplete="tel"
              required
              class="border-input bg-background min-h-11 rounded-xl border px-3"
            />
          </label>
          <label class="grid gap-2 text-sm font-medium" for="email">
            Email
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              required
              class="border-input bg-background min-h-11 rounded-xl border px-3"
            />
          </label>
        </div>
        <div class="flex flex-wrap items-center gap-5">
          <button
            type="submit"
            class={buttonVariants({ size: 'lg', className: 'min-h-11 px-5' })}
          >
            Open the request in your email
          </button>
          <a
            href="/contact/"
            class="text-primary rounded-sm text-sm font-medium underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4"
          >
            Or use the contact page
          </a>
        </div>
      </form>
      <div
        id="inquiry-ready"
        class="mt-6 hidden max-w-2xl rounded-2xl bg-muted/50 p-6"
        role="status"
      >
        <h3 class="text-lg font-semibold">
          Request ready for Ayoub to review.
        </h3>
        <p
          id="inquiry-ready-copy"
          class="text-muted-foreground mt-2 text-sm leading-6"
        ></p>
        <p class="mt-3 text-sm leading-6">
          This does not reserve the date, and this page does not send the email
          itself.
        </p>
        <a
          id="inquiry-mailto"
          class="text-primary mt-4 inline-flex min-h-11 items-center text-sm font-medium underline underline-offset-4"
          href=""
        >
          Open the email draft again
        </a>
      </div>
    </section>
    <script>
      import {
        inquiryErrors,
        inquiryMailto,
      } from '../../lib/event-portrait-inquiry'

      const form = document.querySelector('#event-portrait-inquiry')
      const errors = document.querySelector('#inquiry-errors')
      const ready = document.querySelector('#inquiry-ready')
      const readyCopy = document.querySelector('#inquiry-ready-copy')
      const mailtoLink = document.querySelector('#inquiry-mailto')
      const keys = [
        'coverage',
        'extraTime',
        'date',
        'venue',
        'city',
        'guests',
        'eventType',
        'name',
        'phone',
        'email',
      ]

      form?.addEventListener('submit', (event) => {
        event.preventDefault()
        if (
          !(form instanceof HTMLFormElement) ||
          !(errors instanceof HTMLElement) ||
          !(ready instanceof HTMLElement) ||
          !(readyCopy instanceof HTMLElement) ||
          !(mailtoLink instanceof HTMLAnchorElement)
        ) {
          return
        }
        const data = new FormData(form)
        const fields = Object.fromEntries(
          keys.map((key) => [key, String(data.get(key) ?? '')]),
        )
        const packages = [...form.querySelectorAll('option')]
          .filter((option) => option.value !== '')
          .map((option) => {
            const price = option.textContent?.split('starting at ')[1]?.trim()
            return { hours: option.value, price: price ?? '' }
          })
        const problems = inquiryErrors(fields, packages)
        const first = Object.values(problems)[0]
        if (first) {
          errors.classList.remove('hidden')
          errors.textContent = first
          errors.focus()
          ready.classList.add('hidden')
          return
        }
        const href = inquiryMailto(fields, packages)
        const selected = packages.find(
          (option) => option.hours === fields.coverage,
        )
        errors.classList.add('hidden')
        ready.classList.remove('hidden')
        readyCopy.textContent = `${fields.coverage}, starting at ${selected?.price}.`
        mailtoLink.href = href
        window.location.href = href
      })
    </script>
  </main>
</BaseLayout>
