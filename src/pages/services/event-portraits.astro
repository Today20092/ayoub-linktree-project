---
import '../../styles.css'
import { Image, getImage } from 'astro:assets'
import { Check } from 'lucide-react'
import { getEntry } from 'astro:content'
import { buttonVariants } from '@/components/ui/button'
import { Field, FieldGroup, FieldLabel } from '@/components/ui/field'
import { Separator } from '@/components/ui/separator'
import BaseLayout from '../../layouts/BaseLayout.astro'
import angelPortrait from '../../assets/portraits/angel-birthday-cover.jpg'
import type { ImageMetadata } from 'astro'
import {
  eventPortraitDescription,
  eventPortraitEmail,
  eventPortraitExtraHour,
  eventPortraitMapsUrl,
  eventPortraitPackages,
  eventPortraitProofGalleryUrl,
  eventPortraitStructuredData,
  eventPortraitTitle,
} from '../../lib/event-portrait-offer'
import { siteConfig } from '../../lib/site-config'

const mcc = await getEntry('portfolio', 'muslim-business-chamber-2026')
if (!mcc) throw new Error('Missing MCC workshop portfolio entry')
const mccImage = mcc.data.featuredImage
const suitPortrait = Object.values(
  import.meta.glob<{ default: ImageMetadata }>(
    '../../assets/portraits/P1210377.JPG',
    { eager: true },
  ),
)[0].default

const title = eventPortraitTitle
const description = eventPortraitDescription
const canonicalUrl = new URL(
  '/services/event-portraits/',
  Astro.site,
).toString()
const ogImage = new URL(siteConfig.site.ogImage, Astro.site).toString()
const packages = eventPortraitPackages
const heroImage = await getImage({
  src: angelPortrait,
  layout: 'full-width',
  fit: 'cover',
  position: 'center',
  widths: [480, 720, 1080],
  sizes: '(min-width: 1024px) 50vw, 100vw',
  quality: 82,
})
const link =
  'text-link rounded-sm font-medium underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4'
const control =
  'border-input bg-background aria-invalid:border-destructive min-h-11 rounded-xl border px-3'
const proof = [
  {
    image: angelPortrait,
    width: angelPortrait.width,
    height: angelPortrait.height,
    alt: 'Angel celebrating his birthday with family around the cake',
    event: 'Angel’s birthday party',
    href: eventPortraitProofGalleryUrl,
    label: 'See the gallery',
  },
  {
    image: suitPortrait,
    width: suitPortrait.width,
    height: suitPortrait.height,
    alt: 'Professional event portrait of a smiling man wearing a navy suit',
    event: 'Event portrait',
    href: '/portfolio/portraits/',
    label: 'Portrait portfolio',
  },
  {
    image: mccImage.src,
    width: mccImage.width,
    height: mccImage.height,
    alt: mcc.data.imageAlt,
    event: 'Muslim Chamber of Commerce USA workshop',
    href: '/portfolio/muslim-business-chamber-2026/',
    label: 'Attendee portraits',
  },
]
type InquiryField = {
  id: string
  label: string
  type?: 'date' | 'number' | 'tel' | 'email'
  autocomplete?: string
  placeholder?: string
}
const eventFields: InquiryField[][] = [
  [
    { id: 'date', label: 'Date', type: 'date' },
    { id: 'guests', label: 'Guests', type: 'number' },
  ],
  [
    { id: 'venue', label: 'Venue' },
    { id: 'city', label: 'City', autocomplete: 'address-level2' },
  ],
  [
    {
      id: 'eventType',
      label: 'Event type',
      placeholder: 'Birthday, mosque, school, or nonprofit',
    },
  ],
]
const contactFields: InquiryField[] = [
  { id: 'name', label: 'Name', autocomplete: 'name' },
  { id: 'phone', label: 'Phone', type: 'tel', autocomplete: 'tel' },
  { id: 'email', label: 'Email', type: 'email', autocomplete: 'email' },
]
---

<BaseLayout
  activeNav="portraits"
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  ogImage={ogImage}
  ogImageWidth={siteConfig.site.ogImageWidth}
  ogImageHeight={siteConfig.site.ogImageHeight}
  ogImageType={siteConfig.site.ogImageType}
  ogImageAlt={siteConfig.site.ogImageAlt}
  twitterHandle={siteConfig.site.twitterHandle}
  structuredData={eventPortraitStructuredData(canonicalUrl)}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={heroImage.src}
    imagesrcset={heroImage.srcSet.attribute}
    imagesizes={heroImage.attributes.sizes}
    fetchpriority="high"
  />
  <main
    id="main-content"
    class="portrait-page mx-auto w-full max-w-screen-2xl self-center px-4 sm:px-6 lg:px-8"
  >
    <section
      aria-labelledby="experience-title"
      class="portrait-hero grid items-center gap-8 py-8 sm:py-14 lg:grid-cols-2 lg:gap-16 lg:py-20"
    >
      <div class="min-w-0">
        <p class="eyebrow">Ayoub Abedrabbo / Event photography / Tampa, FL</p>
        <h1
          id="experience-title"
          class="font-heading text-4xl leading-[1.08] font-extrabold tracking-tight text-balance sm:text-5xl lg:text-6xl"
        >
          Good company.
          <br />
          Great memories.
          <br />
          <em>Already in the gallery.</em>
        </h1>
        <p class="mt-5 max-w-lg text-lg leading-8">
          Enjoy your event. I’ll photograph the people who make it yours—with
          portraits included and a gallery that updates within minutes.
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-5">
          <a
            href="#inquiry"
            class={`${buttonVariants({ size: 'lg' })} min-h-11 px-5`}
          >
            Let’s plan your event<span aria-hidden="true">↗</span>
          </a>
          <a href="#pricing" class={`${link} text-sm`}>
            See starting prices
          </a>
        </div>
        <p class="hero-note">
          From $400 · You host. Your guests get the photos free.
        </p>
      </div>
      <figure class="hero-photo min-w-0">
        <Image
          src={angelPortrait}
          alt="Angel celebrating his birthday with family around the cake"
          layout="full-width"
          widths={[480, 720, 1080]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          loading="eager"
          fetchpriority="high"
          quality={82}
          class="aspect-[4/3] rounded-2xl object-cover"
        />
        <figcaption class="text-muted-foreground mt-3 text-sm leading-6">
          <span class="photo-label">A real celebration. A real gallery.</span>
          Angel’s birthday ·
          <a href={eventPortraitProofGalleryUrl} class={link}>
            See the gallery
          </a>
        </figcaption>
      </figure>
    </section>

    <Separator />

    <section aria-labelledby="experience-heading" class="experience-section">
      <div class="section-heading">
        <p class="eyebrow">01 / The experience</p>
        <h2 id="experience-heading">
          Be there for the moment.
          <br />
          <em>I’ll take care of the photos.</em>
        </h2>
      </div>
      <ol class="experience-steps">
        <li>
          <span>01</span>
          <h3>Make it your event.</h3>
          <p>
            Tell me the date, place, and people. We’ll confirm availability and
            the right amount of coverage.
          </p>
        </li>
        <li>
          <span>02</span>
          <h3>Bring everyone together.</h3>
          <p>
            Event photography and portrait sessions, without a backdrop, flash,
            or lighting kit.
          </p>
        </li>
        <li>
          <span>03</span>
          <h3>Share while it’s happening.</h3>
          <p>
            Photos appear in your event gallery within minutes. Guests can
            browse and download at no charge.
          </p>
        </li>
      </ol>
    </section>

    <section aria-labelledby="proof-title" class="proof-section py-10 sm:py-14">
      <div class="section-heading proof-heading">
        <div>
          <p class="eyebrow">02 / Through my lens</p>
          <h2 id="proof-title">
            Real people.<em>Your kind of event.</em>
          </h2>
        </div>
        <p>
          From birthday celebrations to community gatherings.
          <br />
          Explore the photos before you make a plan.
        </p>
      </div>
      <ul class="proof-grid grid gap-6 md:grid-cols-3">
        {proof.map((item, index) => (
          <li>
            <figure>
              <Image
                src={
                  // Local metadata and remote URLs both work at runtime; the cast only satisfies the props union.
                  item.image as string
                }
                width={item.width}
                height={item.height}
                alt={item.alt}
                layout="full-width"
                widths={[400, 640, 960]}
                sizes="(min-width: 768px) 33vw, 100vw"
                quality={78}
                loading={index < 2 ? 'eager' : 'lazy'}
                class="aspect-[4/3] rounded-2xl object-cover"
              />
              <figcaption class="text-muted-foreground mt-3 text-sm leading-6">
                <span class="proof-event">{item.event}</span>
                <a
                  href={item.href}
                  aria-label={`${item.label}: ${item.event}`}
                  class={link}
                >
                  {item.label} <span aria-hidden="true">↗</span>
                </a>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </section>

    <Separator />

    <section
      id="pricing"
      aria-labelledby="pricing-title"
      class="scroll-mt-24 py-10 sm:py-14"
    >
      <div class="pricing-intro">
        <p class="eyebrow">03 / Make room for the memories</p>
        <h2
          id="pricing-title"
          class="font-heading text-2xl font-bold tracking-tight sm:text-3xl"
        >
          Your event.<em>Your pace.</em>
        </h2>
        <p class="text-muted-foreground mt-4 max-w-md leading-7">
          Every booking includes event photography, portrait sessions, and your
          live gallery. Choose a starting point below.
        </p>
        <p class="mt-5 text-sm">Travel within 30 miles of Tampa included.</p>
      </div>
      <div class="coverage-panel mt-6 w-full max-w-2xl">
        <p class="mb-4 px-4 text-sm">
          Choose coverage to fill in your inquiry.
        </p>
        <div class="text-muted-foreground flex justify-between px-4 pb-3 text-xs font-medium">
          <span>Coverage</span>
          <span>Starting at</span>
        </div>
        <ul class="divide-y border-y">
          {packages.map((option) => (
            <li>
              <button
                type="button"
                data-coverage={option.hours}
                aria-pressed="false"
                class="hover:bg-muted/50 aria-pressed:bg-muted aria-pressed:border-primary focus-visible:outline-ring flex min-h-11 w-full items-center justify-between gap-4 border-l-2 border-transparent px-4 py-4 text-left focus-visible:outline-2 focus-visible:outline-offset-2"
              >
                <span>
                  <span class="block font-semibold">{option.hours}</span>
                  <span class="text-muted-foreground mt-1 block text-sm">
                    Planning pace: about 20 portrait sessions per hour, not a
                    cap
                  </span>
                </span>
                <span class="coverage-price shrink-0 text-2xl font-bold tabular-nums">
                  <small>from</small> {option.price}{' '}
                  <span class="coverage-check" aria-hidden="true">
                    <Check size={16} />
                  </span>
                </span>
              </button>
            </li>
          ))}
        </ul>
        <p class="text-muted-foreground mt-4 px-4 text-sm leading-6">
          Need more time? Add an extra hour for{' '}
          <span class="text-foreground font-medium tabular-nums">
            +{eventPortraitExtraHour.price}
          </span>
          .
        </p>
        <div class="mt-4 grid gap-1 px-4 text-sm leading-6">
          <p>
            <a href="#inquiry" class={link}>
              Continue to event details ↗
            </a>
          </p>
          <p class="text-muted-foreground">
            No backdrop, flash, or lighting kit.
          </p>
        </div>
      </div>
    </section>

    <Separator />

    <section
      id="inquiry"
      aria-labelledby="inquiry-title"
      class="scroll-mt-24 py-10 sm:py-14"
    >
      <div class="grid items-start gap-8 lg:grid-cols-2 lg:gap-16">
        <div class="lg:sticky lg:top-24">
          <p class="eyebrow">04 / Let’s make it happen</p>
          <h2
            id="inquiry-title"
            class="font-heading text-2xl font-bold tracking-tight sm:text-3xl"
          >
            Tell me what
            <br />
            you’re<em>celebrating.</em>
          </h2>
          <p class="text-muted-foreground mt-4 max-w-md leading-7">
            Opens an email draft to Ayoub. It does not reserve the date.
          </p>
          <p class="text-muted-foreground mt-3 max-w-md leading-7">
            I’ll review the details with you and confirm availability. For
            coverage up to 8 hours or extras, include what you have in mind.
          </p>
        </div>
        <div class="inquiry-panel">
          <form id="event-portrait-inquiry" class="grid gap-6" novalidate>
            <div
              id="inquiry-errors"
              class="border-destructive bg-destructive/10 text-foreground hidden rounded-xl border px-4 py-3 text-sm"
              tabindex="-1"
              role="alert"
            ></div>
            <fieldset>
              <legend class="mb-4 text-sm font-semibold">The event</legend>
              <FieldGroup>
                <div class="grid gap-4 sm:grid-cols-2">
                  <Field>
                    <FieldLabel htmlFor="coverage" className="justify-between">
                      Coverage
                      <span class="text-muted-foreground text-xs font-normal">
                        Required
                      </span>
                    </FieldLabel>
                    <select
                      id="coverage"
                      name="coverage"
                      required
                      aria-describedby="error-coverage"
                      class={control}
                    >
                      <option value="">Choose coverage</option>
                      {packages.map((option) => (
                        <option value={option.hours}>
                          {option.hours}, starting at {option.price}
                        </option>
                      ))}
                    </select>
                    <p
                      id="error-coverage"
                      class="text-foreground text-sm"
                      hidden
                    ></p>
                  </Field>
                  <Field>
                    <FieldLabel htmlFor="extraTime" className="justify-between">
                      Longer coverage
                      <span class="text-muted-foreground text-xs font-normal">
                        Optional
                      </span>
                    </FieldLabel>
                    <input
                      id="extraTime"
                      name="extraTime"
                      class={control}
                      placeholder="Up to 8 hours"
                    />
                  </Field>
                </div>
                {eventFields.map((row) => (
                  <div
                    class:list={[
                      'grid gap-4',
                      row.length > 1 && 'sm:grid-cols-2',
                    ]}
                  >
                    {row.map((field) => (
                      <Field>
                        <FieldLabel
                          htmlFor={field.id}
                          className="justify-between"
                        >
                          {field.label}
                          <span class="text-muted-foreground text-xs font-normal">
                            Required
                          </span>
                        </FieldLabel>
                        <input
                          id={field.id}
                          name={field.id}
                          type={field.type ?? 'text'}
                          autocomplete={field.autocomplete}
                          placeholder={field.placeholder}
                          {...(field.type === 'number'
                            ? { min: '1', step: '1', inputmode: 'numeric' }
                            : {})}
                          required
                          aria-describedby={`error-${field.id}`}
                          class={control}
                        />
                        <p
                          id={`error-${field.id}`}
                          class="text-foreground text-sm"
                          hidden
                        ></p>
                      </Field>
                    ))}
                  </div>
                ))}
              </FieldGroup>
            </fieldset>
            <fieldset>
              <legend class="mb-4 text-sm font-semibold">
                How to reach you
              </legend>
              <FieldGroup className="grid gap-4 sm:grid-cols-2">
                {contactFields.map((field) => (
                  <Field>
                    <FieldLabel htmlFor={field.id} className="justify-between">
                      {field.label}
                      <span class="text-muted-foreground text-xs font-normal">
                        Required
                      </span>
                    </FieldLabel>
                    <input
                      id={field.id}
                      name={field.id}
                      type={field.type ?? 'text'}
                      autocomplete={field.autocomplete}
                      enterkeyhint={field.id === 'email' ? 'done' : undefined}
                      required
                      aria-describedby={`error-${field.id}`}
                      class={control}
                    />
                    <p
                      id={`error-${field.id}`}
                      class="text-foreground text-sm"
                      hidden
                    ></p>
                  </Field>
                ))}
              </FieldGroup>
            </fieldset>
            <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
              <p
                id="inquiry-selection"
                class="text-sm font-medium"
                aria-live="polite"
                hidden
              ></p>
              <button
                type="submit"
                class={buttonVariants({
                  size: 'lg',
                  className: 'min-h-11 px-5',
                })}
              >
                Open email draft
              </button>
              <a href="/contact/" class={`${link} text-sm`}>
                Or use the contact page
              </a>
            </div>
          </form>
          <div
            id="inquiry-ready"
            class="bg-muted/50 mt-6 hidden rounded-2xl p-6"
            role="status"
          >
            <h3 class="text-lg font-semibold">
              Request ready for Ayoub to review.
            </h3>
            <p
              id="inquiry-ready-copy"
              class="text-muted-foreground mt-2 text-sm leading-6"
            ></p>
            <p class="mt-3 text-sm leading-6">
              This does not reserve the date, and this page does not send the
              email itself.
            </p>
            <a
              id="inquiry-mailto"
              class="text-link mt-4 inline-flex min-h-11 items-center text-sm font-medium underline underline-offset-4"
              href=""
            >
              Open the email draft again
            </a>
          </div>
        </div>
      </div>
    </section>

    <Separator />

    <section aria-label="Contact" class="py-8 text-sm leading-7">
      <p class="flex flex-wrap gap-x-2">
        <span>Ayoub Abedrabbo · Alpha Bravo Media</span>
        <span aria-hidden="true">·</span>
        <a href={`mailto:${eventPortraitEmail}`} class={link}>
          {eventPortraitEmail}
        </a>
        <span aria-hidden="true">·</span>
        <span>Tampa, Florida</span>
        <span aria-hidden="true">·</span>
        <a href={eventPortraitMapsUrl} class={link}>
          Find us on Google Maps
        </a>
      </p>
    </section>
    <script>
      import {
        inquiryErrors,
        inquiryMailto,
      } from '../../lib/event-portrait-inquiry'

      const form = document.querySelector('#event-portrait-inquiry')
      const errors = document.querySelector('#inquiry-errors')
      const ready = document.querySelector('#inquiry-ready')
      const readyCopy = document.querySelector('#inquiry-ready-copy')
      const mailtoLink = document.querySelector('#inquiry-mailto')
      const coverage = document.querySelector('#coverage')
      const selection = document.querySelector('#inquiry-selection')
      const fieldNames = [
        'coverage',
        'date',
        'venue',
        'city',
        'guests',
        'eventType',
        'name',
        'phone',
        'email',
      ]
      const clearFieldErrors = () => {
        for (const name of fieldNames) {
          document.getElementById(name)?.removeAttribute('aria-invalid')
          const message = document.getElementById(`error-${name}`)
          if (message) {
            message.hidden = true
            message.textContent = ''
          }
        }
      }
      const showFieldErrors = (
        problems: Partial<Record<(typeof fieldNames)[number], string>>,
      ) => {
        clearFieldErrors()
        let first: HTMLElement | null = null
        for (const name of fieldNames) {
          const message = problems[name]
          if (!message) continue
          const field = document.getElementById(name)
          const slot = document.getElementById(`error-${name}`)
          field?.setAttribute('aria-invalid', 'true')
          if (slot) {
            slot.hidden = false
            slot.textContent = message
          }
          if (!first && field) first = field
        }
        first?.focus()
      }
      const showSelection = () => {
        if (
          !(coverage instanceof HTMLSelectElement) ||
          !(selection instanceof HTMLElement)
        ) {
          return
        }
        const label = coverage.selectedOptions[0]?.textContent?.trim() ?? ''
        document.querySelectorAll('[data-coverage]').forEach((button) => {
          if (!(button instanceof HTMLButtonElement)) return
          button.setAttribute(
            'aria-pressed',
            button.dataset.coverage === coverage.value ? 'true' : 'false',
          )
        })
        if (!coverage.value || !label) {
          selection.hidden = true
          selection.textContent = ''
          return
        }
        selection.hidden = false
        selection.textContent = label
      }
      coverage?.addEventListener('change', showSelection)
      document.querySelectorAll('[data-coverage]').forEach((button) => {
        button.addEventListener('click', () => {
          if (
            !(button instanceof HTMLButtonElement) ||
            !(coverage instanceof HTMLSelectElement)
          ) {
            return
          }
          coverage.value = button.dataset.coverage ?? ''
          showSelection()
        })
      })
      form?.addEventListener('submit', (event) => {
        event.preventDefault()
        if (
          !(form instanceof HTMLFormElement) ||
          !(errors instanceof HTMLElement) ||
          !(ready instanceof HTMLElement) ||
          !(readyCopy instanceof HTMLElement) ||
          !(mailtoLink instanceof HTMLAnchorElement)
        ) {
          return
        }
        const data = new FormData(form)
        const fields = {
          coverage: String(data.get('coverage') ?? ''),
          extraTime: String(data.get('extraTime') ?? ''),
          date: String(data.get('date') ?? ''),
          venue: String(data.get('venue') ?? ''),
          city: String(data.get('city') ?? ''),
          guests: String(data.get('guests') ?? ''),
          eventType: String(data.get('eventType') ?? ''),
          name: String(data.get('name') ?? ''),
          phone: String(data.get('phone') ?? ''),
          email: String(data.get('email') ?? ''),
        }
        const packages = [...form.querySelectorAll('option')]
          .filter((option) => option.value !== '')
          .map((option) => {
            const price = option.textContent?.split('starting at ')[1]?.trim()
            return { hours: option.value, price: price ?? '' }
          })
        const problems = inquiryErrors(fields, packages)
        const messages = Object.values(problems)
        if (messages.length > 0) {
          errors.classList.remove('hidden')
          errors.textContent =
            messages.length === 1
              ? messages[0]
              : `Check ${messages.length} fields.`
          ready.classList.add('hidden')
          showFieldErrors(problems)
          return
        }
        const href = inquiryMailto(fields, packages)
        const selected = packages.find(
          (option) => option.hours === fields.coverage,
        )
        clearFieldErrors()
        errors.classList.add('hidden')
        ready.classList.remove('hidden')
        readyCopy.textContent = `${fields.coverage}, starting at ${selected?.price}.`
        mailtoLink.href = href
        mailtoLink.click()
      })
    </script>
  </main>
</BaseLayout>

<style>
  .portrait-page {
    max-width: 1360px;
    overflow-wrap: anywhere;
  }
  .portrait-hero a[href='#inquiry'],
  #event-portrait-inquiry button[type='submit'] {
    max-width: 100%;
    height: auto;
    white-space: normal;
    padding-block: 0.75rem;
  }
  #inquiry :global(.grid > *),
  #event-portrait-inquiry fieldset,
  #event-portrait-inquiry input,
  #event-portrait-inquiry select {
    min-width: 0;
  }
  #event-portrait-inquiry input,
  #event-portrait-inquiry select {
    width: 100%;
  }
  #event-portrait-inquiry :global([data-slot='field-label']) {
    max-width: 100%;
    flex-wrap: wrap;
  }
  .eyebrow {
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted-foreground);
    margin-bottom: 1.5rem;
  }
  .portrait-hero {
    padding-block: 5rem 6rem;
    gap: 3rem;
  }
  .portrait-hero h1 {
    font-family: var(--font-jakarta), sans-serif;
    font-size: clamp(2.6rem, 4.7vw, 4.7rem);
    font-weight: 500;
    letter-spacing: -0.065em;
    line-height: 1.1;
  }
  em {
    font-family: var(--font-zodiak), serif;
