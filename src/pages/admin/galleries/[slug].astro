---
import '../../../styles.css'

import { env } from 'cloudflare:workers'
import { ArrowLeft, ExternalLink } from 'lucide-react'

import AdminGallery from '../../../components/AdminGallery'
import { buttonVariants } from '../../../components/ui/button'
import { galleryReader } from '../../../lib/gallery-read'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import PageContainer from '../../../components/layout/PageContainer.astro'
import PageHeader from '../../../components/layout/PageHeader.astro'

export const prerender = false

const eventSlug = Astro.params.slug
const gallery = eventSlug
  ? await galleryReader(env.GALLERY_DB).getAdminDetail(eventSlug)
  : undefined
if (!gallery || !eventSlug) {
  return new Response(null, { status: 404 })
}
const event = gallery.staticEvent
const { settings, guests, uploadedPhotos, invites, professional } = gallery
const eventTitle = gallery.title
const eventMeta = {
  title: eventTitle,
  summary: gallery.summary,
  category: gallery.category,
  eventDate: gallery.eventDate?.toISOString().slice(0, 10) ?? '',
  eventTime: gallery.eventTime ?? '',
  eventVenue: gallery.eventVenue ?? '',
  comingSoon: gallery.comingSoon,
  visibilityStatus: gallery.visibility,
  coverSrc: gallery.cover?.src,
}
---

<BaseLayout
  title={`Manage ${eventTitle}`}
  description={`Review guest uploads and curate ${eventTitle}.`}
  canonicalUrl={new URL(
    `/admin/galleries/${eventSlug}/`,
    Astro.site,
  ).toString()}
  privatePage
>
  <PageContainer width="wide" class="py-10">
    <div class="flex flex-wrap items-center justify-between gap-3 [&_a]:h-auto [&_a]:max-w-full [&_a]:whitespace-normal">
      <a
        class={buttonVariants({ variant: 'ghost', size: 'sm' })}
        href="/admin/galleries/"
      >
        <ArrowLeft data-icon="inline-start" aria-hidden="true" />
        All galleries
      </a>
      <a
        class={buttonVariants({ variant: 'outline', size: 'sm' })}
        href={`/galleries/${eventSlug}/${gallery.dynamicEvent?.is_unlisted ? '?share=' + gallery.dynamicEvent.share_token : ''}`}
        target="_blank"
        aria-label={`View gallery: ${eventTitle}`}
      >
        View gallery
        <ExternalLink data-icon="inline-end" aria-hidden="true" />
      </a>
    </div>

    <PageHeader
      eyebrow="Gallery administration"
      title={eventTitle}
      class="mt-8 max-w-3xl"
    >
      <Fragment slot="lead">
        Review guest submissions, control upload access, and hide professional
        photos from the live gallery.
      </Fragment>
    </PageHeader>

    <div class="mt-10">
      <AdminGallery
        client:only="react"
        eventSlug={eventSlug}
        eventMeta={eventMeta}
        sharing={{
          unlisted: Boolean(gallery.dynamicEvent?.is_unlisted),
          token: gallery.dynamicEvent?.share_token,
          portfolio: Boolean(event),
        }}
        settings={settings}
        guests={guests}
        uploadedPhotos={uploadedPhotos}
        invites={invites}
        professional={professional}
      />
    </div>
  </PageContainer>
</BaseLayout>
