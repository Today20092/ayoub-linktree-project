---
import '../../../styles.css'
import { buttonVariants } from '@/components/ui/button'

import type { ImageMetadata } from 'astro'
import Image from '../../../components/GalleryImage.astro'
import { env } from 'cloudflare:workers'
import { ChevronRight, Images } from 'lucide-react'

import AdminEventCreator from '../../../components/AdminEventCreator'
import { Badge } from '../../../components/ui/badge'
import {
  Card,
  CardContent,
  CardHeader,
  CardTitle,
} from '../../../components/ui/card'
import { galleryReader } from '../../../lib/gallery-read'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import PageContainer from '../../../components/layout/PageContainer.astro'
import PageHeader from '../../../components/layout/PageHeader.astro'

export const prerender = false

const galleries = await galleryReader(env.GALLERY_DB).listAdmin()
---

<BaseLayout
  title="Gallery administration"
  description="Manage event gallery uploads and culling."
  canonicalUrl={new URL('/admin/galleries/', Astro.site).toString()}
  privatePage
>
  <PageContainer width="wide" class="py-10">
    <PageHeader eyebrow="Admin" title="Event galleries" class="max-w-2xl">
      <Fragment slot="lead">
        Create event galleries, upload web-ready photos, generate guest links,
        and curate published galleries.
      </Fragment>
    </PageHeader>

    <div class="mt-8 flex flex-wrap items-start gap-4">
      <a
        href="/admin/galleries/devices/"
        class={buttonVariants({ size: 'lg', className: 'min-h-11 px-6' })}
      >
        Connect Android app
      </a>
      <details class="min-w-0 grow rounded-2xl border p-4">
        <summary class="cursor-pointer font-semibold">New gallery</summary>
        <div class="mt-4">
          <AdminEventCreator client:only="react" />
        </div>
      </details>
    </div>

    <section
      class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3"
      aria-label="Manage event galleries"
    >
      {galleries.map(
        (
          {
            event,
            settings,
            pending,
            published,
            cover,
            coverAlt,
            title,
            category,
            visibilityStatus,
          },
          index,
        ) => (
          <Card className="transition-colors hover:bg-muted/30">
            <a
              href={`/admin/galleries/${event.id}/`}
              class="focus-visible:ring-ring rounded-xl focus-visible:ring-2 focus-visible:outline-none"
            >
              {typeof cover === 'object' && 'filename' in cover ? (
                <Image
                  src={cover.src}
                  alt={cover.alt}
                  width={Math.min(cover.width, 720)}
                  height={Math.round(
                    (cover.height * Math.min(cover.width, 720)) / cover.width,
                  )}
                  layout="full-width"
                  widths={[480, 720]}
                  sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                  loading={index < 3 ? 'eager' : 'lazy'}
                  priority={index === 0}
                  class="aspect-[4/3] w-full object-cover"
                />
              ) : typeof cover === 'object' ? (
                <Image
                  src={cover as ImageMetadata}
                  alt={coverAlt}
                  width={Math.min((cover as ImageMetadata).width, 720)}
                  widths={[480, 720]}
                  sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                  loading={index < 3 ? 'eager' : 'lazy'}
                  priority={index === 0}
                  class="aspect-[4/3] w-full object-cover"
                />
              ) : null}
              <CardHeader>
                <div class="flex items-start justify-between gap-3">
                  <CardTitle>{title}</CardTitle>
                  <ChevronRight
                    className="text-muted-foreground size-5 shrink-0"
                    aria-hidden="true"
                  />
                </div>
              </CardHeader>
              <CardContent className="flex flex-wrap gap-2">
                <Badge
                  variant={settings?.uploads_enabled ? 'default' : 'outline'}
                >
                  Uploads {settings?.uploads_enabled ? 'open' : 'closed'}
                </Badge>
                {pending > 0 && (
                  <Badge variant="destructive">{pending} pending</Badge>
                )}
                {visibilityStatus === 'coming_soon' && (
                  <Badge variant="outline">Coming soon</Badge>
                )}
                {visibilityStatus === 'hidden' && (
                  <Badge variant="destructive">Hidden</Badge>
                )}
                <Badge
                  variant="outline"
                  className="min-w-0 flex-1"
                  title={category}
                >
                  <span class="truncate">{category}</span>
                </Badge>
                <Badge variant="secondary">
                  <Images aria-hidden="true" />
                  {published} guest
                </Badge>
              </CardContent>
            </a>
          </Card>
        ),
      )}
    </section>
  </PageContainer>
</BaseLayout>
