---
import '../../styles.css'

import type { ImageMetadata } from 'astro'
import { Image, getImage } from 'astro:assets'
import { getCollection, render, type CollectionEntry } from 'astro:content'
import { ArrowLeft, ArrowRight, ArrowUpRight, Download } from 'lucide-react'
import PortfolioLocation from '../../components/PortfolioLocation.astro'
import MotionPreview from '../../components/MotionPreview.astro'
import UpcomingVideo from '../../components/UpcomingVideo'
import YouTubeEmbed from '../../components/YouTubeEmbed.astro'
import ProjectComparison from '../../components/sections/portfolio/ProjectComparison.astro'
import ProjectGallery from '../../components/sections/portfolio/ProjectGallery.astro'
import ProjectMilestones from '../../components/sections/portfolio/ProjectMilestones.astro'
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
} from '../../components/ui/breadcrumb'
import { buttonVariants } from '../../components/ui/button'
import { Separator } from '../../components/ui/separator'
import { eventGalleries } from '../../data/event-galleries'
import BaseLayout from '../../layouts/BaseLayout.astro'
import {
  eventPortraitPath,
  eventPortraitProofProjects,
} from '../../lib/event-portrait-offer'
import { sortPortfolioProjects } from '../../lib/portfolio-order'
import { cn } from '../../lib/utils'

export async function getStaticPaths() {
  const projects = (await getCollection('portfolio')).sort(
    sortPortfolioProjects,
  )

  return projects.map((project, index) => ({
    params: { slug: project.id },
    props: {
      project,
      previousProject:
        index > 0
          ? {
              id: projects[index - 1].id,
              title: projects[index - 1].data.title,
            }
          : undefined,
      nextProject:
        index < projects.length - 1
          ? {
              id: projects[index + 1].id,
              title: projects[index + 1].data.title,
            }
          : undefined,
    },
  }))
}

type Props = {
  project: CollectionEntry<'portfolio'>
  previousProject?: { id: string; title: string }
  nextProject?: { id: string; title: string }
}

const { project, previousProject, nextProject } = Astro.props as Props
const { Content, headings } = await render(project)
const projectData = project.data
const hasLongStory =
  headings.filter((heading) => heading.depth === 2).length >= 4
const resultsHeading = headings.find(
  (heading) => heading.depth === 2 && /results/i.test(heading.text),
)
const heroImageAsset = projectData.heroImage ?? projectData.featuredImage
const heroImage =
  typeof heroImageAsset === 'object' &&
  heroImageAsset !== null &&
  'filename' in heroImageAsset
    ? heroImageAsset.src
    : (heroImageAsset as ImageMetadata | string)
const heroImageAlt =
  typeof heroImageAsset === 'object' &&
  heroImageAsset !== null &&
  'alt' in heroImageAsset
    ? heroImageAsset.alt
    : projectData.imageAlt
const heroImageWidth =
  typeof heroImageAsset === 'object' &&
  heroImageAsset !== null &&
  'width' in heroImageAsset
    ? heroImageAsset.width
    : projectData.imageWidth
const heroImageHeight =
  typeof heroImageAsset === 'object' &&
  heroImageAsset !== null &&
  'height' in heroImageAsset
    ? heroImageAsset.height
    : projectData.imageHeight
const heroDisplayWidth = Math.min(heroImageWidth, 1280)
const heroDisplayHeight = Math.round(
  (heroImageHeight * heroDisplayWidth) / heroImageWidth,
)
const heroPreload = await getImage({
  src: heroImage,
  width: projectData.heroVideo ? 1280 : heroDisplayWidth,
  height: projectData.heroVideo ? 720 : heroDisplayHeight,
  widths: projectData.heroVideo ? [640, 960, 1280] : [640, 960, 1280, 1600],
  sizes:
    '(min-width: 960px) 896px, (min-width: 640px) calc(100vw - 48px), calc(100vw - 32px)',
  layout: 'full-width',
  fit: 'cover',
  position: 'center',
  quality: projectData.heroVideo ? 80 : 70,
})
const remoteGalleryImages = projectData.eventGallery
  ? projectData.gallery.length > 0
    ? projectData.gallery.filter(
        (
          image,
        ): image is Extract<
          (typeof projectData.gallery)[number],
          { filename: string }
        > => 'filename' in image,
      )
    : (eventGalleries[project.id] ?? [])
  : []
const galleryImages = projectData.eventGallery
  ? []
  : projectData.gallery.map((image) => ({
      ...image,
      src: image.src as ImageMetadata,
    }))
const hasBody = Boolean(project.body?.trim())
const canonicalUrl = new URL(`/portfolio/${project.id}/`, Astro.site).toString()
const socialImage = await getImage({
  src: heroImage,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpg',
  quality: 80,
})
const socialImageUrl = new URL(socialImage.src, Astro.site).toString()
const projectTitle =
  projectData.seoTitle ?? `${projectData.title} - Ayoub Abedrabbo`
const projectDescription = projectData.seoDescription ?? projectData.summary
const sitemapUrl = new URL('/sitemap.xml', Astro.site).toString()
const comparisonVideos = projectData.videos.filter(
  (video) => video.comparisonRole,
)
const milestoneVideos = projectData.videos.filter(
  (video) => !video.comparisonRole && video.youtubeId !== projectData.heroVideo,
)
const hasDetails = Boolean(
  projectData.collaborators.length ||
  projectData.duration ||
  projectData.tools.length,
)
---

<BaseLayout
  title={projectTitle}
  description={projectDescription}
  canonicalUrl={canonicalUrl}
  ogImage={socialImageUrl}
  ogImageAlt={heroImageAlt}
  ogImageWidth={1200}
  ogImageHeight={630}
  ogImageType="image/jpeg"
  ogType="article"
  robots="index,follow,max-image-preview:large"
  sitemapUrl={sitemapUrl}
  preconnectHints={['https://i.ytimg.com']}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={heroPreload.src}
    imagesrcset={heroPreload.srcSet.attribute}
    imagesizes={heroPreload.attributes.sizes}
    fetchpriority="high"
  />
  <main
    id="main-content"
    class="mx-auto w-full max-w-screen-2xl px-4 py-6 sm:px-6 sm:py-8 lg:px-8"
  >
    <MotionPreview />
    <header class="mx-auto max-w-4xl" data-reveal="fade">
      <Breadcrumb>
        <BreadcrumbList className="gap-x-3 gap-y-2">
          <BreadcrumbItem>
            <BreadcrumbLink
              href="/#portfolio"
              className="link-quiet inline-flex min-h-11 items-center"
            >
              Portfolio
            </BreadcrumbLink>
          </BreadcrumbItem>
        </BreadcrumbList>
      </Breadcrumb>
    </header>

    <article class="pt-8 pb-12 sm:pt-12 lg:pb-20">
      <header class="mx-auto max-w-4xl pb-8 sm:pb-10">
        <h1 class="font-heading max-w-3xl text-3xl leading-tight font-extrabold tracking-tight text-balance sm:text-4xl lg:text-5xl">
          {projectData.title}
        </h1>
        <p class="text-muted-foreground mt-4 max-w-3xl text-lg leading-8">
          {projectData.summary}
        </p>
        {projectData.role && (
          <p class="mt-4 max-w-3xl text-sm leading-6">
            <span class="font-bold">My role:</span> {projectData.role}
          </p>
        )}
        {hasLongStory && (
          <nav
            aria-label="On this project"
            class="mt-5 flex flex-wrap gap-x-6 gap-y-1"
          >
            <a
              href="#project-work"
              class="link-quiet inline-flex min-h-11 items-center font-bold"
            >
              View work
            </a>
            {resultsHeading ? (
              <a
                href={`#${resultsHeading.slug}`}
                class="link-quiet inline-flex min-h-11 items-center font-bold"
              >
                Results
              </a>
            ) : (
              projectData.outcomes.length > 0 && (
                <a
                  href="#project-results"
                  class="link-quiet inline-flex min-h-11 items-center font-bold"
                >
                  Delivery
                </a>
              )
            )}
            <a
              href="#project-story"
              class="link-quiet inline-flex min-h-11 items-center font-bold"
            >
              Process
            </a>
          </nav>
        )}
      </header>

      <div
        id="project-work"
        class="mx-auto max-w-4xl scroll-mt-24"
        data-reveal="up"
        data-motion-hero
      >
        {projectData.heroVideo ? (
          <YouTubeEmbed
            youtubeId={projectData.heroVideo}
            title={`${projectData.title} featured video`}
            poster={heroImage}
            posterAlt={heroImageAlt}
          />
        ) : typeof heroImage === 'string' ? (
          <Image
            src={heroImage}
            alt={heroImageAlt}
            width={heroDisplayWidth}
            height={heroDisplayHeight}
            layout="full-width"
            widths={[640, 960, 1280, 1600]}
            sizes="(min-width: 960px) 896px, (min-width: 640px) calc(100vw - 48px), calc(100vw - 32px)"
            quality={70}
            priority
            class="bg-muted block h-auto w-full"
          />
        ) : (
          <Image
            src={heroImage}
            alt={heroImageAlt}
            width={heroDisplayWidth}
            height={heroDisplayHeight}
            layout="full-width"
            widths={[640, 960, 1280, 1600]}
            sizes="(min-width: 960px) 896px, (min-width: 640px) calc(100vw - 48px), calc(100vw - 32px)"
            quality={70}
            priority
            class="bg-muted block h-auto w-full"
          />
        )}
      </div>

      {projectData.eventGallery && remoteGalleryImages.length > 0 ? (
        <aside
          class="mx-auto max-w-4xl py-8 sm:py-10"
          aria-labelledby="gallery-cta-title"
          data-reveal="up"
        >
          <Separator className="mb-8 sm:mb-10" />
          <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
            <div class="max-w-xl">
              <h2
                id="gallery-cta-title"
                class="font-heading text-2xl font-bold"
              >
                View the event gallery
              </h2>
              <p class="text-muted-foreground mt-3 leading-7">
                Browse all {remoteGalleryImages.length}{' '}
                {remoteGalleryImages.length === 1
                  ? 'photograph'
                  : 'photographs'}{' '}
                full screen, share individual shots, or download the full set.
              </p>
            </div>
            <div class="flex flex-col gap-2 sm:shrink-0">
              <a
                href={`/galleries/${project.id}/`}
                class={cn(
                  buttonVariants({ size: 'lg' }),
                  'w-full justify-center sm:w-auto',
                )}
              >
                Open gallery
                <ArrowRight data-icon="inline-end" aria-hidden="true" />
              </a>
              {projectData.downloadAllUrl && (
                <a
                  href={projectData.downloadAllUrl}
                  download
                  class={cn(
                    buttonVariants({ variant: 'outline', size: 'lg' }),
                    'w-full justify-center sm:w-auto',
                  )}
                >
                  <Download data-icon="inline-start" aria-hidden="true" />
                  Download all
                </a>
              )}
            </div>
          </div>
        </aside>
      ) : galleryImages.length > 0 ? (
        <ProjectGallery
          projectId={project.id}
          images={galleryImages}
          layout={projectData.galleryLayout}
          heading={projectData.galleryHeading}
        />
      ) : null}

      {hasBody && (
        <section
          id="project-story"
          class="typeset typeset-portfolio mx-auto max-w-4xl scroll-mt-24 py-8 sm:py-10"
          data-reveal="up"
        >
          <Content />
        </section>
      )}

      {projectData.location && (
        <PortfolioLocation
          title={projectData.title}
          {...projectData.location}
        />
      )}

      {projectData.services.length > 0 && (
        <section
          class="mx-auto max-w-4xl py-8 sm:py-10"
          aria-labelledby="services-title"
          data-reveal="up"
        >
          <h2 id="services-title" class="font-heading text-2xl font-bold">
            Deliverables
          </h2>
          <ul class="mt-5 grid gap-x-8 gap-y-3 sm:grid-cols-2">
            {projectData.services.map((service) => (
              <li class="py-1 leading-7">{service}</li>
            ))}
          </ul>
        </section>
      )}

      {eventPortraitProofProjects.has(project.id) && (
        <p class="mx-auto max-w-4xl pb-8 sm:pb-10" data-reveal="up">
          <a
            href={eventPortraitPath}
            class="link-quiet hover:text-link text-foreground inline-flex min-h-11 items-center gap-2 font-bold"
          >
            See event photography starting prices
            <ArrowRight className="size-4" aria-hidden="true" />
          </a>
        </p>
      )}

      {hasDetails && (
        <section
          class="bg-muted/50 mx-auto my-8 max-w-4xl rounded-sm p-6 sm:my-10 sm:p-8"
          aria-labelledby="details-title"
          data-reveal="up"
        >
          <h2 id="details-title" class="font-heading text-2xl font-bold">
            Details
          </h2>
          <dl class="mt-5 grid gap-6 sm:grid-cols-2">
            {projectData.collaborators.length > 0 && (
              <div>
                <dt class="text-foreground/70 text-xs font-semibold tracking-wider uppercase">
                  Collaborators
                </dt>
                <dd class="mt-2 leading-7">
                  {projectData.collaborators.join(', ')}
                </dd>
              </div>
            )}
            {projectData.duration && (
              <div>
                <dt class="text-foreground/70 text-xs font-semibold tracking-wider uppercase">
                  Duration
                </dt>
                <dd class="mt-2 leading-7">{projectData.duration}</dd>
              </div>
            )}
          </dl>
          {projectData.tools.length > 0 && (
            <details class="mt-6">
              <summary class="text-muted-foreground focus-visible:ring-ring hover:text-foreground cursor-pointer rounded-sm py-3 text-sm font-medium focus-visible:ring-2 focus-visible:outline-none">
                Tools and equipment
              </summary>
              <Separator className="my-2" />
              <p class="text-muted-foreground mt-2 text-sm leading-7">
                {projectData.tools.join(', ')}
              </p>
            </details>
          )}
        </section>
      )}

      {comparisonVideos.length > 0 && (
        <ProjectComparison videos={comparisonVideos} />
      )}

      {milestoneVideos.length > 0 && (
        <ProjectMilestones projectId={project.id} videos={milestoneVideos} />
      )}

      {projectData.upcomingVideo && (
        <UpcomingVideo {...projectData.upcomingVideo} />
      )}

      {projectData.outcomes.length > 0 && (
        <section
          id="project-results"
          class="mx-auto max-w-4xl scroll-mt-24 py-8 sm:py-10"
          aria-labelledby="outcomes-title"
          data-reveal="up"
        >
          <h2 id="outcomes-title" class="font-heading text-2xl font-bold">
            Outcomes
          </h2>
          <ul class="mt-5 grid gap-x-10 gap-y-5 sm:grid-cols-2">
            {projectData.outcomes.map((outcome) => (
              <li class="leading-7">{outcome}</li>
            ))}
          </ul>
        </section>
      )}

      {projectData.links.length > 0 && (
        <>
          <Separator className="mx-auto max-w-4xl" />
          <section
            class="mx-auto max-w-4xl py-8 sm:py-10"
            aria-labelledby="links-title"
            data-reveal="up"
          >
            <h2 id="links-title" class="font-heading text-2xl font-bold">
              Project links
            </h2>
            <div class="mt-6 flex flex-wrap gap-3">
              {projectData.links.map((link) => (
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={cn(
                    buttonVariants({
                      variant: 'outline',
                      size: 'lg',
                    }),
                    'h-auto min-h-11 max-w-full justify-start gap-3 px-4 py-3 text-left whitespace-normal',
                  )}
                >
                  <span class="min-w-0">
                    {link.label === 'Website'
                      ? `${projectData.title} website`
                      : link.label}
                  </span>
                  <ArrowUpRight data-icon="inline-end" aria-hidden="true" />
                </a>
              ))}
            </div>
          </section>
        </>
      )}

      {(previousProject || nextProject) && (
        <>
          <Separator className="mx-auto max-w-4xl" />
          <nav
            class="mx-auto grid max-w-4xl gap-2 pt-6 sm:grid-cols-2 sm:pt-8"
            aria-label="More portfolio projects"
            data-reveal="fade"
          >
            {previousProject && (
              <a
                href={`/portfolio/${previousProject.id}/`}
                class={cn(
                  buttonVariants({
                    variant: 'ghost',
                    size: 'lg',
                  }),
                  'h-auto w-full justify-start px-3 py-3 text-left whitespace-normal',
                )}
              >
                <ArrowLeft data-icon="inline-start" aria-hidden="true" />
                <span class="min-w-0">
                  <small class="text-muted-foreground block text-xs font-semibold tracking-wider uppercase">
                    Previous project
                  </small>
                  <span class="font-bold">{previousProject.title}</span>
                </span>
              </a>
            )}
            {nextProject && (
              <a
                href={`/portfolio/${nextProject.id}/`}
                class={cn(
                  buttonVariants({
                    variant: 'ghost',
                    size: 'lg',
                  }),
                  'h-auto w-full justify-end px-3 py-3 text-right whitespace-normal sm:col-start-2',
                )}
              >
                <span class="min-w-0">
                  <small class="text-muted-foreground block text-xs font-semibold tracking-wider uppercase">
                    Next project
                  </small>
                  <span class="font-bold">{nextProject.title}</span>
                </span>
                <ArrowRight data-icon="inline-end" aria-hidden="true" />
              </a>
            )}
          </nav>
        </>
      )}
    </article>
  </main>
</BaseLayout>
