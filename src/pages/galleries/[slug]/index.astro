---
import '../../../styles.css'

import Image from '../../../components/GalleryImage.astro'
import { getImage } from 'astro:assets'
import { eventPortraitPath } from '../../../lib/event-portrait-offer'
import {
  galleryImageUrl,
  galleryMediaKey,
  galleryThumbnailSrcset,
} from '../../../lib/gallery-media'
import { ArrowRight, ChevronDown, Heart, ImageUp, Search } from 'lucide-react'
import { env } from 'cloudflare:workers'

import EventLightbox from '../../../components/EventLightbox'
import EventComingSoon from '../../../components/EventComingSoon.astro'
import FaceFinder from '../../../components/FaceFinder'
import GalleryGridControls from '../../../components/GalleryGridControls.astro'
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbSeparator,
} from '../../../components/ui/breadcrumb'
import { Badge } from '../../../components/ui/badge'
import { Button } from '../../../components/ui/button'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { faceManifests } from '../../../lib/face-manifests'
import { galleryReader } from '../../../lib/gallery-read'
import {
  GALLERY_PAGE_SIZE,
  galleryPage,
  galleryPagePath,
} from '../../../lib/gallery-pagination'
import { siteConfig } from '../../../lib/site-config'

export const prerender = false

const eventSlug = Astro.params.slug
const gallery = eventSlug
  ? await galleryReader(env.GALLERY_DB).getPublicDetail(
      eventSlug,
      Astro.url.searchParams.get('share') ?? undefined,
    )
  : undefined
if (!gallery || !eventSlug) {
  return new Response(null, { status: 404 })
}
if (gallery.isUnlisted) {
  Astro.response.headers.set('Cache-Control', 'no-store')
  Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow')
  Astro.response.headers.set('Referrer-Policy', 'no-referrer')
}
const project = gallery.staticEvent
const data = project?.data
const gallerySettings = gallery.settings
const allImages = gallery.allImages
const totalPhotoCount = allImages.length
const page = galleryPage(Astro.url.searchParams, totalPhotoCount)
if (!page)
  return new Response(null, { status: 404, headers: Astro.response.headers })
const pageCount = Math.max(1, Math.ceil(totalPhotoCount / GALLERY_PAGE_SIZE))
const pageStart = (page - 1) * GALLERY_PAGE_SIZE
const professionalCount = gallery.professionalImages.length
const images = gallery.professionalImages.slice(
  pageStart,
  pageStart + GALLERY_PAGE_SIZE,
)
const guestStart = Math.max(0, pageStart - professionalCount)
const guestImages = gallery.guestImages.slice(
  guestStart,
  Math.max(0, pageStart + GALLERY_PAGE_SIZE - professionalCount),
)
const pathname = `/galleries/${eventSlug}/`
const viewingToken = gallery.isUnlisted
  ? (Astro.url.searchParams.get('share') ?? undefined)
  : undefined
const pagePath = (number: number) =>
  galleryPagePath(pathname, number, viewingToken)

const galleryId = `gallery-${eventSlug}`
const galleryUrl = new URL(`/galleries/${eventSlug}/`, Astro.site).toString()
const canonicalUrl = new URL(
  galleryPagePath(pathname, page),
  Astro.site,
).toString()
const portfolioUrl = project ? `/portfolio/${project.id}/` : '/galleries/'
const galleryTitle = gallery.title
const galleryCategory = gallery.category
const galleryImageAlt = data?.imageAlt ?? `${galleryTitle} event gallery`
const summary = gallery.summary
const title = `${galleryTitle} — ${page > 1 ? `Page ${page}` : 'Photos'}`
const description =
  totalPhotoCount > 0
    ? `${galleryTitle}: photos ${pageStart + 1}–${Math.min(pageStart + GALLERY_PAGE_SIZE, totalPhotoCount)} of ${totalPhotoCount}. Browse event photos full screen, find your moments, and download copies to keep.`
    : summary
const ogImage = new URL(gallery.ogImage, Astro.url).toString()
const eventDate = gallery.eventDate
const tipUrl = siteConfig.socialLinks.find((link) => link.id === 'kofi')?.url
const faceManifest = gallery.isUnlisted ? undefined : faceManifests[eventSlug]
const flyer = gallery.flyerImage
const galleryHeroImage = gallery.heroImage

const imageDimensions = (width: number, height: number, maxWidth: number) => {
  const scale = Math.min(1, maxWidth / width)
  return {
    width: Math.max(1, Math.round(width * scale)),
    height: Math.max(1, Math.round(height * scale)),
  }
}
const lightboxPreview = allImages[0]
  ? imageDimensions(allImages[0].width, allImages[0].height, 720)
  : undefined
const heroDimensions = galleryHeroImage
  ? imageDimensions(galleryHeroImage.width, galleryHeroImage.height, 1280)
  : undefined
const heroSizes = '(min-width: 1024px) 56rem, 100vw'
// Uploaded R2 heroes use GalleryImage's custom optimizer, not Astro asset URLs.
const heroPreload =
  galleryHeroImage && heroDimensions && !galleryMediaKey(galleryHeroImage.src)
    ? await getImage({
        src: galleryHeroImage.src,
        ...heroDimensions,
        layout: 'constrained',
        fit: 'cover',
        position: 'center',
        widths: [360, 720, 960, 1280],
        sizes: heroSizes,
        quality: 85,
      })
    : undefined
const ogImageWidth = galleryHeroImage?.width ?? allImages[0]?.width ?? 1200
const ogImageHeight = galleryHeroImage?.height ?? allImages[0]?.height ?? 800

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(date)
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  ogImage={ogImage}
  ogImageAlt={galleryImageAlt}
  ogImageWidth={ogImageWidth}
  ogImageHeight={ogImageHeight}
  ogType="article"
  disableAnalytics={gallery.isUnlisted}
  robots={
    gallery.isUnlisted
      ? 'noindex,nofollow'
      : 'index,follow,max-image-preview:large'
  }
  activeNav="galleries"
  structuredData={
    gallery.isUnlisted
      ? undefined
      : {
          '@context': 'https://schema.org',
          '@type': 'BreadcrumbList',
          itemListElement: [
            {
              '@type': 'ListItem',
              position: 1,
              name: 'Home',
              item: new URL('/', Astro.site).toString(),
            },
            {
              '@type': 'ListItem',
              position: 2,
              name: 'Galleries',
              item: new URL('/galleries/', Astro.site).toString(),
            },
            {
              '@type': 'ListItem',
              position: 3,
              name: galleryTitle,
              item: galleryUrl,
            },
          ],
        }
  }
>
  {heroPreload && (
    <link
      slot="head"
      rel="preload"
      as="image"
      href={heroPreload.src}
      imagesrcset={heroPreload.srcSet.attribute}
      imagesizes={heroPreload.attributes.sizes}
      fetchpriority="high"
    />
  )}
  <main
    id="main-content"
    class="mx-auto w-full max-w-screen-2xl scroll-mt-20 px-4 py-6 sm:px-6 sm:py-8 lg:px-8"
  >
    <div data-reveal="fade">
      <Breadcrumb>
        <BreadcrumbList>
          <BreadcrumbItem>
            <BreadcrumbLink
              href="/"
              className="focus-visible:ring-ring rounded-sm focus-visible:ring-2 focus-visible:outline-none"
            >
              Home
            </BreadcrumbLink>
          </BreadcrumbItem>
          <BreadcrumbSeparator />
          <BreadcrumbItem>
            <BreadcrumbLink
              href="/galleries/"
              className="focus-visible:ring-ring rounded-sm focus-visible:ring-2 focus-visible:outline-none"
            >
              Galleries
            </BreadcrumbLink>
          </BreadcrumbItem>
        </BreadcrumbList>
      </Breadcrumb>
    </div>

    {gallery.isUnlisted && (
      <p class="text-muted-foreground mt-6 text-sm">
        Unlisted gallery. Anyone with this link can view and forward it. Shared
        image URLs remain accessible.
      </p>
    )}
    <header class="mx-auto max-w-4xl pt-6 sm:pt-8" data-reveal="up">
      <div class="flex flex-wrap items-center gap-2">
        {eventDate && (
          <Badge variant="secondary">{formatDate(eventDate)}</Badge>
        )}
        <Badge variant="outline">{galleryCategory}</Badge>
        {totalPhotoCount > 0 ? (
          <span class="text-muted-foreground text-xs font-semibold">
            {totalPhotoCount}
            {totalPhotoCount === 1 ? ' photograph' : ' photographs'}
          </span>
        ) : (
          <Badge variant="outline">Coming soon</Badge>
        )}
      </div>
      <h1 class="font-heading mt-3 text-2xl leading-tight font-extrabold tracking-tight sm:text-4xl lg:text-5xl">
        {galleryTitle}
      </h1>
      <p class="text-muted-foreground mt-3 max-w-2xl text-sm leading-relaxed sm:text-base">
        {summary}
      </p>
    </header>

    {professionalCount > 0 && (
      <figure
        class="gallery-cover mx-auto mt-4 max-w-4xl overflow-hidden rounded-xl sm:mt-8 sm:rounded-2xl"
        data-reveal="up"
      >
        {galleryHeroImage
          ? (() => {
              const dimensions = imageDimensions(
                galleryHeroImage.width,
                galleryHeroImage.height,
                1280,
              )
              return (
                <Image
                  src={galleryHeroImage.src}
                  alt={galleryHeroImage.alt}
                  width={dimensions.width}
                  height={dimensions.height}
                  layout="constrained"
                  widths={[360, 720, 960, 1280]}
                  sizes="(min-width: 1024px) 56rem, 100vw"
                  quality={85}
                  priority
                  class="bg-muted block aspect-[3/2] size-full object-cover"
                />
              )
            })()
          : flyer && (
              <Image
                src={flyer as ImageMetadata}
                alt={galleryImageAlt}
                widths={[720, 1080, 1440, 1920]}
                sizes="(min-width: 1024px) 56rem, 100vw"
                quality={85}
                priority
                class="bg-muted block aspect-[3/2] size-full object-cover"
              />
            )}
      </figure>
    )}

    {faceManifest && (
      <details class="gallery-search border-border group mx-auto mt-4 max-w-4xl border-y">
        <summary class="focus-visible:ring-ring grid min-h-14 cursor-pointer list-none grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-3 rounded-sm py-3 text-sm font-bold focus-visible:ring-2 focus-visible:outline-none">
          <Search className="size-4" aria-hidden="true" />
          <span class="flex min-w-0 flex-col gap-1">
            <span>Find your photos</span>
            <span class="text-muted-foreground text-xs font-normal">
              Use a selfie
            </span>
          </span>
          <ChevronDown
            className="size-4 transition-transform group-open:rotate-180"
            aria-hidden="true"
          />
        </summary>
        <FaceFinder
          client:only="react"
          eventSlug={eventSlug}
          indexVersion={faceManifest.version}
          model={faceManifest.model}
          galleryId={galleryId}
        />
      </details>
    )}

    {totalPhotoCount === 0 && flyer ? (
      <EventComingSoon
        flyer={flyer}
        flyerAlt={galleryImageAlt}
        date={eventDate ? formatDate(eventDate) : 'Date coming soon'}
        time={gallery.eventTime ?? undefined}
        venue={gallery.eventVenue ?? undefined}
        upcomingVideo={data?.upcomingVideo}
      />
    ) : (
      <section
        id={galleryId}
        class="mt-4"
        data-gallery-browser
        data-gallery-page={page}
        data-gallery-page-size={GALLERY_PAGE_SIZE}
        tabindex="-1"
        data-gallery-has-picks="false"
        aria-label={`${galleryTitle} photographs`}
      >
        {totalPhotoCount > 0 && <GalleryGridControls count={totalPhotoCount} />}
        {totalPhotoCount > 0 && (
          <a
            data-gallery-load-earlier
            hidden
            class="gallery-page-link"
            href={pagePath(page - 1)}
          >
            Load earlier photos
          </a>
        )}
        <div data-gallery-page-content>
          {images.length > 0 && (
            <div data-gallery-grid data-photo-grid>
              {images.map((image, index) => {
                const dimensions = imageDimensions(
                  image.width,
                  image.height,
                  960,
                )
                const srcset = galleryThumbnailSrcset(
                  image.src,
                  dimensions.width,
                  dimensions.height,
                )
                return (
                  <figure
                    class="relative mb-1 break-inside-avoid"
                    data-gallery-filename={image.filename}
                  >
                    {faceManifest && (
                      <Badge
                        variant="secondary"
                        data-face-rank
                        hidden
                        className="absolute top-2 left-2"
                      >
                        Match
                      </Badge>
                    )}
                    <a
                      href={image.src}
                      data-gallery-open={pageStart + index}
                      aria-label={`Open photograph ${pageStart + index + 1}: ${image.alt}`}
                      class="group bg-muted focus-visible:ring-ring block overflow-hidden focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none"
                    >
                      <Image
                        {...(srcset ? { srcset } : {})}
                        src={
                          galleryImageUrl(
                            image.src,
                            480,
                            Math.round(
                              (dimensions.height * 480) / dimensions.width,
                            ),
                            75,
                          ) ?? image.src
                        }
                        alt={image.alt}
                        width={dimensions.width}
                        height={dimensions.height}
                        layout="full-width"
                        widths={[80, 160, 240, 480, 960]}
                        sizes="(min-width: 768px) 20vw, 33vw"
                        quality={85}
                        loading={index < 5 ? 'eager' : 'lazy'}
                        decoding="async"
                        class="block h-auto w-full transition-opacity duration-300 ease-out group-hover:opacity-90"
                      />
                    </a>
                    <Button
                      type="button"
                      variant="secondary"
                      size="icon"
                      data-gallery-favorite
                      disabled
                      data-filename={image.filename}
                      data-selected="false"
                      aria-label={`Add photograph ${pageStart + index + 1} to favorites`}
                      aria-pressed="false"
                      className="absolute top-2 right-2 min-h-11 min-w-11 shadow-md data-[selected=true]:bg-primary data-[selected=true]:text-primary-foreground data-[selected=true]:[&_svg]:fill-current"
                    >
                      <Heart aria-hidden="true" />
                    </Button>
                  </figure>
                )
              })}
            </div>
          )}
          {guestImages.length > 0 && (
            <section
              class="mt-14"
              aria-labelledby="guest-photos-heading"
              data-reveal="up"
            >
              <div class="mb-6 max-w-2xl">
                <Badge variant="secondary">Community gallery</Badge>
                <h2
                  id="guest-photos-heading"
                  class="font-heading mt-3 text-2xl font-extrabold tracking-tight sm:text-3xl"
                >
                  Photos shared by guests
                </h2>
                <p class="text-muted-foreground mt-2 leading-7">
                  Moments captured and submitted by people who attended the
                  event.
                </p>
              </div>
              <div data-photo-grid>
                {guestImages.map((image, index) => {
                  const dimensions = imageDimensions(
                    image.width,
                    image.height,
                    960,
                  )
                  const photoIndex = professionalCount + guestStart + index
                  const srcset = galleryThumbnailSrcset(
                    image.src,
                    dimensions.width,
                    dimensions.height,
                  )
                  return (
                    <figure
                      class="relative mb-1 break-inside-avoid"
                      data-gallery-filename={image.filename}
                    >
                      <a
                        href={image.src}
                        data-gallery-open={photoIndex}
                        aria-label={`Open guest photograph ${guestStart + index + 1}: ${image.alt}`}
                        class="group bg-muted focus-visible:ring-ring block overflow-hidden focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none"
                      >
                        <Image
                          {...(srcset ? { srcset } : {})}
                          src={
                            galleryImageUrl(
                              image.src,
                              480,
                              Math.round(
                                (dimensions.height * 480) / dimensions.width,
                              ),
                              75,
                            ) ?? image.src
                          }
                          alt={image.alt}
                          width={dimensions.width}
                          height={dimensions.height}
                          layout="full-width"
                          widths={[80, 160, 240, 480, 960]}
                          sizes="(min-width: 768px) 20vw, 33vw"
                          quality={85}
                          loading="lazy"
                          decoding="async"
                          class="block h-auto w-full transition-opacity duration-300 ease-out group-hover:opacity-90"
                        />
                      </a>
                      <Button
                        type="button"
                        variant="secondary"
                        size="icon"
                        data-gallery-favorite
                        disabled
                        data-filename={image.filename}
                        data-selected="false"
                        aria-label={`Add guest photograph ${guestStart + index + 1} to favorites`}
                        aria-pressed="false"
                        className="absolute top-2 right-2 min-h-11 min-w-11 shadow-md data-[selected=true]:bg-primary data-[selected=true]:text-primary-foreground data-[selected=true]:[&_svg]:fill-current"
                      >
                        <Heart aria-hidden="true" />
                      </Button>
                    </figure>
                  )
                })}
              </div>
            </section>
          )}
        </div>
        {totalPhotoCount > 0 && (
          <div data-gallery-stream hidden class="mt-6 text-center text-sm">
            <p
              data-gallery-stream-status
              role="status"
              class="text-muted-foreground"
            />
            <a
              data-gallery-load-more
              class="gallery-page-link"
              href={pagePath(Math.min(page + 1, pageCount))}
            >
              Load more photos
            </a>
          </div>
        )}
        {totalPhotoCount > 0 && (
          <nav
            data-gallery-pagination
            aria-label="Photo pages"
            class="mt-6 flex flex-wrap items-center justify-center gap-3 text-sm"
          >
            <p class="text-muted-foreground w-full text-center">
              Photos {pageStart + 1}–
              {Math.min(pageStart + GALLERY_PAGE_SIZE, totalPhotoCount)} of{' '}
              {totalPhotoCount}
            </p>
            {page > 1 && (
              <a class="gallery-page-link" href={pagePath(page - 1)} rel="prev">
                Previous photo page
              </a>
            )}
            {Array.from({ length: pageCount }, (_, index) => index + 1).map(
              (number) => (
                <a
                  class="gallery-page-link"
                  href={pagePath(number)}
                  aria-label={`Page ${number}`}
                  aria-current={number === page ? 'page' : undefined}
                >
                  {number}
                </a>
              ),
            )}
            {page < pageCount && (
              <a class="gallery-page-link" href={pagePath(page + 1)} rel="next">
                Next photo page
              </a>
            )}
          </nav>
        )}
        {totalPhotoCount > 0 && (
          <div class="mt-8">
            <EventLightbox
              client:load
              galleryId={galleryId}
              heading={galleryTitle}
              projectSlug={eventSlug}
              shareToken={
                gallery.isUnlisted
                  ? (Astro.url.searchParams.get('share') ?? undefined)
                  : undefined
              }
              projectTitle={galleryTitle}
              downloadAllUrl={data?.downloadAllUrl}
              tipUrl={tipUrl}
              images={allImages.map((image) => ({
                src: image.src,
                filename: image.filename,
                alt: image.alt,
                width: image.width,
                height: image.height,
                caption:
                  'caption' in image && typeof image.caption === 'string'
                    ? image.caption
                    : undefined,
              }))}
            >
              {allImages.slice(0, 1).map((image) => (
                <figure
                  class="m-0 grid max-h-full w-full justify-items-center"
                  data-gallery-slide="0"
                >
                  <Image
                    src={image.src}
                    alt={image.alt}
                    width={lightboxPreview?.width ?? image.width}
                    height={lightboxPreview?.height ?? image.height}
                    layout="constrained"
                    widths={[480, 720]}
                    sizes="min(100vw, 1600px)"
                    quality={75}
                    loading="lazy"
                    decoding="async"
                    data-gallery-original={image.src}
                    class="h-full min-h-0 w-full object-contain"
                  />
                  <figcaption
                    data-gallery-caption
                    class="gallery-viewer-caption max-w-3xl px-3 py-2 text-center text-xs"
                  >
                    {'caption' in image && image.caption
                      ? image.caption
                      : image.filename}
                  </figcaption>
                </figure>
              ))}
            </EventLightbox>
          </div>
        )}
      </section>
    )}

    <footer
      class="border-border mt-12 flex flex-wrap gap-x-6 gap-y-3 border-t pt-6"
      data-reveal="fade"
    >
      {gallerySettings?.uploads_enabled && !gallery.isUnlisted ? (
        <a
          href={`/galleries/${eventSlug}/upload/`}
          class="text-foreground hover:text-link focus-visible:ring-ring inline-flex items-center gap-2 rounded-sm text-sm font-bold underline decoration-dotted underline-offset-4 focus-visible:ring-2 focus-visible:outline-none"
        >
          <ImageUp className="size-4" aria-hidden="true" />
          Ask for a submission link
        </a>
      ) : null}
      <a
        href={portfolioUrl}
        class="text-foreground hover:text-link focus-visible:ring-ring inline-flex items-center gap-2 rounded-sm text-sm font-bold underline decoration-dotted underline-offset-4 focus-visible:ring-2 focus-visible:outline-none"
      >
        {project ? 'About this event' : 'Browse all galleries'}
        <ArrowRight className="size-4" aria-hidden="true" />
      </a>
      <a
        href={eventPortraitPath}
        class="text-foreground hover:text-link focus-visible:ring-ring inline-flex items-center gap-2 rounded-sm text-sm font-bold underline decoration-dotted underline-offset-4 focus-visible:ring-2 focus-visible:outline-none"
      >
        Book event photography
        <ArrowRight className="size-4" aria-hidden="true" />
      </a>
    </footer>
  </main>
</BaseLayout>

<style>
  .gallery-page-link {
    display: inline-flex;
    min-width: 2.75rem;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .gallery-page-link[aria-current='page'] {
    font-weight: 800;
  }
  .gallery-page-link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }
  .gallery-cover :global(img) {
    max-height: 8rem;
    object-position: center 20%;
  }
  .gallery-search :global(summary::-webkit-details-marker) {
    display: none;
  }
  .gallery-search :global(section) {
    margin-top: 0;
    border: 0;
    padding-top: 0.5rem;
    padding-bottom: 1.5rem;
  }
  .gallery-search :global(button) {
    max-width: 100%;
    min-height: 2.75rem;
    height: auto;
    padding-block: 0.5rem;
    white-space: normal;
  }
  @media (min-width: 640px) {
    .gallery-cover :global(img) {
      max-height: none;
      object-position: center;
    }
  }
</style>
