---
import '../../../../styles.css'

import { env } from 'cloudflare:workers'

import GuestUpload from '../../../../components/GuestUpload'
import { galleryReader } from '../../../../lib/gallery-read'
import BaseLayout from '../../../../layouts/BaseLayout.astro'
import GuestUploadShell from '../../../../components/layout/GuestUploadShell.astro'

export const prerender = false

const eventSlug = Astro.params.slug
const token = Astro.params.token
if (!eventSlug || !token) {
  return new Response(null, { status: 404 })
}

const context = await galleryReader(env.GALLERY_DB).getInviteContext(
  eventSlug,
  token,
)
if (!context) {
  return new Response(null, { status: 404 })
}
const { gallery, invite } = context
const eventTitle = gallery.title
const summary = gallery.summary
const ogImage = gallery.flyer?.src ?? gallery.featuredImageSrc
---

<BaseLayout
  privatePage
  title={`Upload photos for ${eventTitle}`}
  description={`Upload photos for ${eventTitle}.`}
  canonicalUrl={new URL(
    `/galleries/${eventSlug}/upload/`,
    Astro.site,
  ).toString()}
  ogImage={ogImage}
  ogImageAlt={`${eventTitle} upload`}
  activeNav="galleries"
>
  <GuestUploadShell
    eyebrow="Guest upload"
    title={`Share photos for ${eventTitle}`}
  >
    <Fragment slot="lead">
      This upload link is assigned to{invite.guest_name}. Photos publish to the
      gallery after upload.
    </Fragment>
    <Fragment slot="details">
      {summary && <p class="text-muted-foreground mt-3 text-sm">{summary}</p>}
    </Fragment>

    <GuestUpload
      client:only="react"
      eventSlug={eventSlug}
      eventTitle={eventTitle}
      enabled
      inviteToken={token}
      guestName={invite.guest_name}
    />
  </GuestUploadShell>
</BaseLayout>
