---
import '../../../../styles.css'

import { env } from 'cloudflare:workers'
import { ArrowLeft } from 'lucide-react'

import GuestUpload from '../../../../components/GuestUpload'
import { buttonVariants } from '../../../../components/ui/button'
import { galleryReader } from '../../../../lib/gallery-read'
import BaseLayout from '../../../../layouts/BaseLayout.astro'
import PageHeader from '../../../../components/layout/PageHeader.astro'

export const prerender = false

const eventSlug = Astro.params.slug
const token = Astro.params.token
if (!eventSlug || !token) {
  return new Response(null, { status: 404 })
}

const context = await galleryReader(env.GALLERY_DB).getInviteContext(
  eventSlug,
  token,
)
if (!context) {
  return new Response(null, { status: 404 })
}
const { gallery, invite } = context
const eventTitle = gallery.title
const summary = gallery.summary
const ogImage = gallery.flyer?.src ?? gallery.featuredImageSrc
---

<BaseLayout
  privatePage
  title={`Upload photos for ${eventTitle}`}
  description={`Upload photos for ${eventTitle}.`}
  canonicalUrl={new URL(
    `/galleries/${eventSlug}/upload/`,
    Astro.site,
  ).toString()}
  ogImage={ogImage}
  ogImageAlt={`${eventTitle} upload`}
  activeNav="galleries"
>
  <main
    id="main-content"
    class="mx-auto w-full max-w-2xl scroll-mt-20 px-4 py-10 sm:px-6 sm:py-14"
  >
    <a
      class={buttonVariants({ variant: 'ghost', size: 'sm' })}
      href="/galleries/"
    >
      <ArrowLeft data-icon="inline-start" aria-hidden="true" />
      Gallery listing
    </a>

    <PageHeader
      eyebrow="Guest upload"
      title={`Share photos for ${eventTitle}`}
      class="mt-8"
    >
      <Fragment slot="lead">
        This upload link is assigned to{invite.guest_name}. Photos publish to
        the gallery after upload.
      </Fragment>
      {summary && <p class="text-muted-foreground mt-3 text-sm">{summary}</p>}
    </PageHeader>

    <div class="mt-8">
      <GuestUpload
        client:only="react"
        eventSlug={eventSlug}
        eventTitle={eventTitle}
        enabled
        inviteToken={token}
        guestName={invite.guest_name}
      />
    </div>
  </main>
</BaseLayout>
