---
import '../../../styles.css'

import { env } from 'cloudflare:workers'

import GuestUpload from '../../../components/GuestUpload'
import { galleryReader } from '../../../lib/gallery-read'
import { matchesSharingToken } from '../../../lib/gallery-sharing'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import GuestUploadShell from '../../../components/layout/GuestUploadShell.astro'

export const prerender = false

const eventSlug = Astro.params.slug
const context = eventSlug
  ? await galleryReader(env.GALLERY_DB).getUploadContext(eventSlug)
  : undefined
if (!context || !eventSlug) {
  return new Response(null, { status: 404 })
}
const { gallery, settings } = context
const submissionToken = Astro.url.searchParams.get('upload')
if (gallery.dynamicEvent?.is_unlisted && !submissionToken)
  return new Response(null, { status: 404 })
if (
  submissionToken &&
  !matchesSharingToken(submissionToken, settings?.upload_token)
)
  return new Response(null, { status: 404 })
const canonicalUrl = new URL(
  `/galleries/${eventSlug}/upload/`,
  Astro.site,
).toString()
const title = `Share photos from ${gallery.title}`
const description = `Submit guest photos from ${gallery.title} for review and inclusion in the event gallery.`
const ogImage = gallery.flyer?.src ?? gallery.featuredImageSrc
---

<BaseLayout
  privatePage
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  ogImage={ogImage}
  ogImageAlt={gallery.imageAlt ?? `${gallery.title} gallery`}
  activeNav="galleries"
>
  <GuestUploadShell eyebrow="Guest photos" title="Share what you captured">
    <Fragment slot="lead">
      Add your photos from{gallery.title}. Every submission is reviewed before
      it appears in the public gallery.
    </Fragment>

    <GuestUpload
      client:only="react"
      eventSlug={eventSlug}
      eventTitle={gallery.title}
      enabled={Boolean(settings?.uploads_enabled)}
      submissionToken={submissionToken ?? undefined}
    />
  </GuestUploadShell>
</BaseLayout>
