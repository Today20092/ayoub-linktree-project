---
import '../styles.css'

import BaseLayout from '../layouts/BaseLayout.astro'
import { siteConfig } from '../lib/site-config'
import { eventPortraitPath } from '../lib/event-portrait-offer'

const { site } = siteConfig
const title = 'Contact Ayoub Abedrabbo | Tampa Digital Media'
const description =
  'Contact Ayoub Abedrabbo in Tampa about photography, videography, podcast production, and digital media work.'
const canonicalUrl = new URL('/contact/', Astro.site).toString()
const ogImage = new URL('/og-ayoub-digital-media.jpg', Astro.site).toString()
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  ogImage={ogImage}
  ogImageWidth={1200}
  ogImageHeight={630}
  ogImageType="image/jpeg"
  ogImageAlt={site.ogImageAlt}
  activeNav="contact"
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: title,
    description,
    url: canonicalUrl,
    mainEntity: {
      '@type': 'Person',
      '@id': new URL('/#person', Astro.site).toString(),
      name: 'Ayoub Abedrabbo',
      email: 'Ayoub@AyoubAbed.xyz',
      url: new URL('/', Astro.site).toString(),
    },
  }}
>
  <main
    id="main-content"
    class="mx-auto w-full max-w-3xl scroll-mt-20 px-4 py-10 sm:px-6 sm:py-14 lg:px-8 lg:py-20"
  >
    <header data-reveal="up">
      <p class="text-link text-sm font-bold tracking-wide uppercase">Contact</p>
      <h1 class="font-heading mt-3 text-4xl leading-none font-extrabold tracking-tight sm:text-5xl">
        Let’s talk about your project
      </h1>
      <p class="text-muted-foreground mt-5 text-lg leading-8">
        Reach Ayoub Abedrabbo for photography, video, podcast production, and
        other digital media work in the Tampa area.
      </p>
      <p class="mt-4 leading-7">
        Planning an event?{' '}
        <a
          class="focus-visible:ring-ring rounded-sm font-bold underline underline-offset-4 focus-visible:ring-2 focus-visible:outline-none"
          href={eventPortraitPath}
        >
          See starting prices and send an inquiry
        </a>
      </p>
    </header>
    <address class="mt-10 not-italic" data-reveal="up">
      <ul class="grid gap-4 sm:grid-cols-2">
        <li class="border-border rounded-xl border p-5">
          <a
            class="font-bold underline underline-offset-4"
            href="mailto:Ayoub@AyoubAbed.xyz"
          >
            Email Ayoub
          </a>
          <p class="text-muted-foreground mt-2 text-sm leading-6">
            Ayoub@AyoubAbed.xyz
          </p>
        </li>
        <li class="border-border rounded-xl border p-5">
          <a
            class="font-bold underline underline-offset-4"
            href="/AyoubA-Contact-Card.vcf"
          >
            Save contact card
          </a>
          <p class="text-muted-foreground mt-2 text-sm leading-6">
            Tampa, Florida
          </p>
        </li>
      </ul>
    </address>
    <p class="text-muted-foreground mt-6 leading-7">
      Learn
      <a href="/about/" class="text-link underline underline-offset-4">
        about Ayoub's background and media work
      </a>
      before planning your project.
    </p>
  </main>
</BaseLayout>
