---
import '../styles.css'

import BaseLayout from '../layouts/BaseLayout.astro'
import PageContainer from '../components/layout/PageContainer.astro'
import PageHeader from '../components/layout/PageHeader.astro'
import { eventPortraitPath } from '../lib/event-portrait-offer'
import { inquiryEmail, personEntity } from '../lib/service-offer'

const title = 'Contact Ayoub Abedrabbo | Tampa Digital Media'
const description =
  'Contact Ayoub Abedrabbo in Tampa about photography, videography, podcast production, and digital media work.'
const canonicalUrl = new URL('/contact/', Astro.site).toString()
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  activeNav="contact"
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: title,
    description,
    url: canonicalUrl,
    mainEntity: personEntity(Astro.site!),
  }}
>
  <PageContainer>
    <PageHeader
      eyebrow="Contact"
      title="Let’s talk about your project"
      data-reveal="up"
    >
      <Fragment slot="lead">
        Reach Ayoub Abedrabbo for photography, video, podcast production, and
        other digital media work in the Tampa area.
      </Fragment>
      <p class="mt-4 leading-7">
        Planning an event?{' '}
        <a class="link-quiet font-bold" href={eventPortraitPath}>
          See starting prices and send an inquiry
        </a>
      </p>
    </PageHeader>
    <address class="mt-10 not-italic" data-reveal="up">
      <ul class="grid gap-4 sm:grid-cols-2">
        <li class="border-border rounded-xl border p-5">
          <a class="link-quiet font-bold" href={`mailto:${inquiryEmail}`}>
            Email Ayoub
          </a>
          <p class="text-muted-foreground mt-2 text-sm leading-6">
            {inquiryEmail}
          </p>
        </li>
        <li class="border-border rounded-xl border p-5">
          <a class="link-quiet font-bold" href="/AyoubA-Contact-Card.vcf">
            Save contact card
          </a>
          <p class="text-muted-foreground mt-2 text-sm leading-6">
            Tampa, Florida
          </p>
        </li>
      </ul>
    </address>
    <p class="text-muted-foreground mt-6 leading-7">
      Learn
      <a href="/about/" class="link">
        about Ayoub's background and media work
      </a>
      before planning your project.
    </p>
  </PageContainer>
</BaseLayout>
