{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "squirrelscan-local-audit",
  "main": "../../dist/server/entry.mjs",
  "compatibility_date": "2026-06-20",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }],
  "assets": { "directory": "../../dist/client", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "GALLERY_DB",
      "database_name": "squirrelscan-local-audit",
      "database_id": "00000000-0000-4000-8000-000000000083",
      "migrations_dir": "../../migrations",
    },
  ],
  "r2_buckets": [
    { "binding": "GALLERY_PUBLIC", "bucket_name": "squirrelscan-audit-public" },
    {
      "binding": "GALLERY_PENDING",
      "bucket_name": "squirrelscan-audit-pending",
    },
  ],
  "images": { "binding": "IMAGES" },
}
